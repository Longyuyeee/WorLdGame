t\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300}},\"executedInstructions\":1,\"historyIndex\":1,\"input\":null},{\"afterCheckpointId\":\"history.d4c39782082afa067e0e0999b6bb46081bf703e2520a832b03b1eebabfe44aad\",\"barriers\":[],\"beforeCheckpointId\":\"history.0ba70f7d125eff50d5a1b31f48fa82b256a6f485ef151ac9e0b42acbaa1b60f7\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.ambient\",\"compensation\":null,\"descriptorId\":\"stmt_ui_3\",\"effectId\":\"effect.2f327917a3cae2f4f48a18e65172558cc569ef18ca6c410a35204738dfd27f6f\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":2,\"originatingRevision\":3,\"payload\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_3\"}],\"entryId\":\"entry.eb1ea7d807d8a2be49b35a43405cf4e42f1322919833223b4fe341b44a17e818\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_3\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200}},\"executedInstructions\":1,\"historyIndex\":2,\"input\":null},{\"afterCheckpointId\":\"history.82e2acf507042ca294db18181ea77af0e7eed1889ee86690bac318ce59634412\",\"barriers\":[],\"beforeCheckpointId\":\"history.d4c39782082afa067e0e0999b6bb46081bf703e2520a832b03b1eebabfe44aad\",\"effects\":[],\"entryId\":\"entry.56d6be25d4130d6d93fa64586af9ac6d4a8b7394562772f1aefc9897eef67f14\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":3,\"input\":null},{\"afterCheckpointId\":\"history.921fd54896c4db073d708717d9492bcd3df66ffab41b6e944c90aff5328e4b08\",\"barriers\":[],\"beforeCheckpointId\":\"history.82e2acf507042ca294db18181ea77af0e7eed1889ee86690bac318ce59634412\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_4\",\"effectId\":\"effect.a3479116a02ee5fb25f696c889b0585ea3ab53ca7d24cebf352f644cfc6654af\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":3,\"originatingRevision\":5,\"payload\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_4\"}],\"entryId\":\"entry.16e896d68361691a51c1660837dfd6b70a72e356d1eef5491afdd89c29eee04e\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_4\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null},{\"afterCheckpointId\":\"history.4871c5b2de7ef8c67976d40c9a7269b1601bfc5383c06a2e329b8bce25d011d9\",\"barriers\":[],\"beforeCheckpointId\":\"history.921fd54896c4db073d708717d9492bcd3df66ffab41b6e944c90aff5328e4b08\",\"effects\":[],\"entryId\":\"entry.bd0b21d49605afcf9a8072a2dc7ffe29cf665b6e9be652544552810cdfbb5556\",\"event\":{\"instructionId\":\"stmt_ui_7\",\"kind\":\"narration\",\"text\":\"小夏不是来阻止他出发的。她在短信里只说，要把借了半年那本书还给他，顺便把书里的照片也还给他。林远原以为这是一件很容易的事：收下书，认真道谢，等广播响起后挥手。可当她撑着伞从街对面走来，他忽然不记得自己排练过的第一句话是什么了。\",\"textId\":\"txt_ui_8\"},\"executedInstructions\":1,\"historyIndex\":5,\"input\":null},{\"afterCheckpointId\":\"history.d7d8571f091098fe9976ed54ca524af651a49e909d641cdf07bc2f94c786d66a\",\"barriers\":[],\"beforeCheckpointId\":\"history.4871c5b2de7ef8c67976d40c9a7269b1601bfc5383c06a2e329b8bce25d011d9\",\"effects\":[],\"entryId\":\"entry.d7e20fc7b01da40e710b01b54b8d862c22fe5e1706138f8b3752869d51753a9e\",\"event\":{\"instructionId\":\"stmt_ui_9\",\"kind\":\"narration\",\"text\":\"照片上是一片没有拍到人的海。去年他们各自请了半天假，到了车站才知道列车停运，只能在便利店买两杯热饮，坐着听了一下午雨。后来小夏独自去了那片海，把拍下的照片寄给他，背面写着：没到的地方不必作废。林远把它夹进书里，每次搬家都带着，却一次也没有认真回复。\",\"textId\":\"txt_ui_10\"},\"executedInstructions\":1,\"historyIndex\":6,\"input\":null},{\"afterCheckpointId\":\"history.16f3db0173047ce6678b84f7e10bb546b6564bee758cd85b1344621bfca60ad2\",\"barriers\":[],\"beforeCheckpointId\":\"history.d7d8571f091098fe9976ed54ca524af651a49e909d641cdf07bc2f94c786d66a\",\"effects\":[],\"entryId\":\"entry.19e5132cee257706facde8955687fd93f3344c59e5ee559132a9b031b2bbfbd3\",\"event\":{\"instructionId\":\"stmt_ui_11\",\"kind\":\"narration\",\"text\":\"他想过许多合理的理由。项目赶进度，新工作的面试，还有一张要交房租的账单。生活确实忙，也确实不容易，可那些理由越整齐，他越清楚自己遗漏了什么：他在所有能回答的事情上回答得很快，只有在小夏问他想不想再约一次的时候，总是说等忙完这一阵。\",\"textId\":\"txt_ui_12\"},\"executedInstructions\":1,\"historyIndex\":7,\"input\":null},{\"afterCheckpointId\":\"history.56dc64bac0c6003c4a4645c1b0fd4b2ebc7a0c3f2da65eecc402432653fade2c\",\"barriers\":[],\"beforeCheckpointId\":\"history.16f3db0173047ce6678b84f7e10bb546b6564bee758cd85b1344621bfca60ad2\",\"effects\":[],\"entryId\":\"entry.462966cfdee820ad939cee9a6b2b7f26ac5db3e6b6e1edc2ee30cb7f21ce692a\",\"event\":{\"instructionId\":\"stmt_ui_13\",\"kind\":\"narration\",\"text\":\"站台的雨味让他想起那间租了三年的房间。窗边原本留着摆画架的位置，后来堆满了纸箱。他给这次换工作起名叫重新开始，仿佛只要把地址换掉，箱子里那些没画完的东西就会自己展开。小夏知道那些画，却从没催他交一张能被称作作品的结果。\",\"textId\":\"txt_ui_14\"},\"executedInstructions\":1,\"historyIndex\":8,\"input\":null}],\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"2eafc0c389545c62be3f4e64b7f0730d52244256df3382a21a869ff3edaf8e26\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":"","origin":"slot"},"sha256":"84059be863991f94932a8073b6c263e3a1f0a4efd5d00a79e3d873ba9b498311"}
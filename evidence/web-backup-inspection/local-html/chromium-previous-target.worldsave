{"schemaVersion":1,"format":"world.player-save-backup","payload":{"slot":{"kind":"manual","slotId":"manual-1","projectId":"project_a983033c0f7180355c93","buildId":"e1de8f8e2a345cbc8157a90ec454c0699538bb807fbd90c984a5927110e2995a","savedAtEpochMilliseconds":1792308188663,"title":"雨停之前","chapterId":"chapter_fb27b85ca00fd9790811","chapterTitle":"Main","sceneId":"scene_87825610ea97b89eeea8","sceneTitle":"车站的雨","route":null,"customMetadata":{},"readingExcerpt":"站台的雨味让他想起那间租了三年的房间。窗边原本留着摆画架的位置，后来堆满了纸箱。他给这次换工作起名叫重新开始，仿佛只要把地址换掉，箱子里那些没画完的东西就会自己展开。小夏知道那些画，却从没催他交一张能被称作作品的结果。","preview":{"status":"available","mimeType":"image/webp","width":512,"height":288,"byteLength":20150,"sha256":"e4a59316de13603347457feddbb4294424d80364d1c3ce76e479afae32eaba3f"},"presentationKind":"narration","runtimeStateHash":"56dc64bac0c6003c4a4645c1b0fd4b2ebc7a0c3f2da65eecc402432653fade2c","sessionArtifactHash":"82d7c28d02d5aca71fe739a7805736bcee979ac01a9889f520d6c48373a7fead","serializedSessionSave":"{\"buildId\":\"e1de8f8e2a345cbc8157a90ec454c0699538bb807fbd90c984a5927110e2995a\",\"cursor\":9,\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"format\":\"world.runtime-session-save\",\"history\":{\"archives\":[],\"buildId\":\"e1de8f8e2a345cbc8157a90ec454c0699538bb807fbd90c984a5927110e2995a\",\"checkpoints\":[{\"checkpointId\":\"history.959e9b4149e2aa4cb2ff07b5908ab18df45309ec21c065185682a379ff630d3c\",\"state\":{\"audioState\":{\"tracks\":{}},\"barrierLedger\":[],\"buildId\":\"e1de8f8e2a345cbc8157a90ec454c0699538bb807fbd90c984a5927110e2995a\",\"callStack\":[],\"cursor\":{\"instructionIndex\":0,\"sceneId\":\"scene_87825610ea97b89eeea8\"},\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"inputReceipts\":[],\"irVersion\":\"1.2.0\",\"logicalTimeMilliseconds\":0,\"metaProgress\":{\"progressScopeId\":\"player\",\"projectId\":\"project_a983033c0f7180355c93\",\"reachedEndingIds\":[],\"readTextIds\":[],\"schemaVersion\":1,\"unlockedGalleryAssetIds\":[]},\"nextEffectSequence\":0,\"nextInputSequence\":0,\"
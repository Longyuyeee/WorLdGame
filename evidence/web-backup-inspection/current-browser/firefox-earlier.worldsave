\":{\"command\":\"background\",\"instructionId\":\"stmt_ui_1\",\"kind\":\"direction\",\"parameters\":{\"action\":\"set\",\"asset\":\"sample_station\"}},\"executedInstructions\":1,\"historyIndex\":0,\"input\":null},{\"afterCheckpointId\":\"history.0ba70f7d125eff50d5a1b31f48fa82b256a6f485ef151ac9e0b42acbaa1b60f7\",\"barriers\":[],\"beforeCheckpointId\":\"history.1d35e4c3f05f613b9ca623511bea0d38467624a7041ee5d0e66c15ea72fb3710\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.bgm\",\"compensation\":null,\"descriptorId\":\"stmt_ui_2\",\"effectId\":\"effect.7b401930c0dbad0482a14c9850cfb61eaf4b85b224e97a2311c4950798d56d04\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":1,\"originatingRevision\":2,\"payload\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_2\"}],\"entryId\":\"entry.79f75418148b96aeb6638e068c34088f0aa1b12f4e2ee28cf802627bea860fdb\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_2\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300}},\"executedInstructions\":1,\"historyIndex\":1,\"input\":null},{\"afterCheckpointId\":\"history.d4c39782082afa067e0e0999b6bb46081bf703e2520a832b03b1eebabfe44aad\",\"barriers\":[],\"beforeCheckpointId\":\"history.0ba70f7d125eff50d5a1b31f48fa82b256a6f485ef151ac9e0b42acbaa1b60f7\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.ambient\",\"compensation\":null,\"descriptorId\":\"stmt_ui_3\",\"effectId\":\"effect.2f327917a3cae2f4f48a18e65172558cc569ef18ca6c410a35204738dfd27f6f\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":2,\"originatingRevision\":3,\"payload\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_3\"}],\"entryId\":\"entry.eb1ea7d807d8a2be49b35a43405cf4e42f1322919833223b4fe341b44a17e818\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_3\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200}},\"executedInstructions\":1,\"historyIndex\":2,\"input\":null},{\"afterCheckpointId\":\"history.82e2acf507042ca294db18181ea77af0e7eed1889ee86690bac318ce59634412\",\"barriers\":[],\"beforeCheckpointId\":\"history.d4c39782082afa067e0e0999b6bb46081bf703e2520a832b03b1eebabfe44aad\",\"effects\":[],\"entryId\":\"entry.56d6be25d4130d6d93fa64586af9ac6d4a8b7394562772f1aefc9897eef67f14\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":3,\"input\":null},{\"afterCheckpointId\":\"history.921fd54896c4db073d708717d9492bcd3df66ffab41b6e944c90aff5328e4b08\",\"barriers\":[],\"beforeCheckpointId\":\"history.82e2acf507042ca294db18181ea77af0e7eed1889ee86690bac318ce59634412\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_4\",\"effectId\":\"effect.a3479116a02ee5fb25f696c889b0585ea3ab53ca7d24cebf352f644cfc6654af\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":3,\"originatingRevision\":5,\"payload\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_4\"}],\"entryId\":\"entry.16e896d68361691a51c1660837dfd6b70a72e356d1eef5491afdd89c29eee04e\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_4\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null},{\"afterCheckpointId\":\"history.4871c5b2de7ef8c67976d40c9a7269b1601bfc5383c06a2e329b8bce25d011d9\",\"barriers\":[],\"beforeCheckpointId\":\"history.921fd54896c4db073d708717d9492bcd3df66ffab41b6e944c90aff5328e4b08\",\"effects\":[],\"entryId\":\"entry.bd0b21d49605afcf9a8072a2dc7ffe29cf665b6e9be652544552810cdfbb5556\",\"event\":{\"instructionId\":\"stmt_ui_7\",\"kind\":\"narration\",\"text\":\"小夏不是来阻止他出发的。她在短信里只说，要把借了半年那本书还给他，顺便把书里的照片也还给他。林远原以为这是一件很容易的事：收下书，认真道谢，等广播响起后挥手。可当她撑着伞从街对面走来，他忽然不记得自己排练过的第一句话是什么了。\",\"textId\":\"txt_ui_8\"},\"executedInstructions\":1,\"historyIndex\":5,\"input\":null}],\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"d20257d95ace5b9afaa177d2cc928f6ffe3e18acbaa9264c1643fd926dff7c82\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":"","origin":"current"},"sha256":"8a5264edb84476855020e2b2c910c77661f30f1453054fea6308a533d05f3ba6"}
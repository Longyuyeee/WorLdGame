{"schemaVersion":1,"format":"world.player-save-backup","payload":{"slot":{"kind":"manual","slotId":"manual-1","projectId":"project_a983033c0f7180355c93","buildId":"e1de8f8e2a345cbc8157a90ec454c0699538bb807fbd90c984a5927110e2995a","savedAtEpochMilliseconds":1792308090691,"title":"雨停之前","chapterId":"chapter_fb27b85ca00fd9790811","chapterTitle":"Main","sceneId":"scene_87825610ea97b89eeea8","sceneTitle":"车站的雨","route":null,"customMetadata":{},"readingExcerpt":"小夏不是来阻止他出发的。她在短信里只说，要把借了半年那本书还给他，顺便把书里的照片也还给他。林远原以为这是一件很容易的事：收下书，认真道谢，等广播响起后挥手。可当她撑着伞从街对面走来，他忽然不记得自己排练过的第一句话是什么了。","preview":{"status":"available","mimeType":"image/webp","width":512,"height":288,"byteLength":32102,"sha256":"4a4e7d3a336b9a895522bf70819ed64448d5eb546dcb0b44db17389a474b161e"},"presentationKind":"narration","runtimeStateHash":"4871c5b2de7ef8c67976d40c9a7269b1601bfc5383c06a2e329b8bce25d011d9","sessionArtifactHash":"434fbc4728450674d7b7350b9809e27b37c06996f7985c4583d771220f56708c","serializedSessionSave":"{\"buildId\":\"e1de8f8e2a345cbc8157a90ec454c0699538bb807fbd90c984a5927110e2995a\",\"cursor\":6,\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"format\":\"world.runtime-session-save\",\"history\":{\"archives\":[],\"buildId\":\"e1de8f8e2a345cbc8157a90ec454c0699538bb807fbd90c984a5927110e2995a\",\"checkpoints\":[{\"checkpointId\":\"history.959e9b4149e2aa4cb2ff07b5908ab18df45309ec21c065185682a379ff630d3c\",\"state\":{\"audioState\":{\"tracks\":{}},\"barrierLedger\":[],\"buildId\":\"e1de8f8e2a345cbc8157a90ec454c0699538bb807fbd90c984a5927110e2995a\",\"callStack\":[],\"cursor\":{\"instructionIndex\":0,\"sceneId\":\"scene_87825610ea97b89eeea8\"},\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"inputReceipts\":[],\"irVersion\":\"1.2.0\",\"logicalTimeMilliseconds\":0,\"metaProgress\":{\"progressScopeId\":\"player\",\"projectId\":\"project_a983033c0f7180355c93\",\"reachedEndingIds\":[],\"readTextIds\":[],\"schemaVersion\":1,\"unlockedGalleryAssetIds\":[]},\"nextEffectSequence\":0,\"nextInputSequence\":
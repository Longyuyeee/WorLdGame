beforeCheckpointId\":\"history.0d1ec28e099f09be5bedfe49f77296d701d691606a5764c69781d00b7c4d3c93\",\"effects\":[],\"entryId\":\"entry.60358dd29564ad51b9d244c2d59d5b9bdd1847cb108e27202435c239d0ee1fe0\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.f87d19179fdf8536f9fc579c\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"86d6c1c116573ed7c5f99542e20e09e41b881c0e6b6310611a2be98936a2872e\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"a9c1946c73321259495394ca04f417562b792a12ad056094349859eebb58fa1d"}
beforeCheckpointId\":\"history.8f2b2d1ac87cfe4098ed69acb189a1fab2a1e7eb791cd3c5da9c88b616794aff\",\"effects\":[],\"entryId\":\"entry.3d87454e7670bb1af83674a9caa485f1a0b7becaf22ed8813c1f1b9f871822a4\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.f6b33c0488f4f3c489d22b6c\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"570b150f5debd10fcd7d7e1b6ee22da7202cbe4d01bee9c1266f5bad322aa1c2\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"6a5433ef5be45bda0d40410ee775cf688a414ddd9ab34f674960d73cc6e1d129"}
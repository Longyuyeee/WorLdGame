dingBarrier\":null,\"pendingChoice\":{\"expectedStateRevision\":56,\"instructionId\":\"stmt_ui_83\",\"instructionIndex\":18,\"logicalSequence\":0,\"options\":[{\"label\":\"今晚留下，把回信写完\",\"optionId\":\"option_ui_85\",\"targetSceneId\":\"scene_e919f09d3b7d45f7\"},{\"label\":\"今晚出发，在路上继续\",\"optionId\":\"option_ui_86\",\"targetSceneId\":\"scene_f4bf99fd319a40a4\"}],\"prompt\":\"最后一班车到了，你准备怎样继续这个约定？\",\"requestId\":\"choice.69a6512e97636a99cc128d0b8ecaa83ace4308ce3e351121d961f8d1171086b1\",\"sceneId\":\"scene_f3c19020bde744aa\"},\"pendingEffect\":null,\"prng\":{\"algorithm\":\"xorshift32-v1\",\"draws\":0,\"state\":1831565813},\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"sceneState\":{\"backgroundAssetId\":\"sample_station\",\"characters\":{\"primary\":{\"assetId\":\"xia_smile\",\"expression\":null}}},\"schemaVersion\":1,\"stateRevision\":56,\"terminal\":{\"kind\":\"running\"},\"variables\":{\"variable_d7b7b177ae48417c\":0}},\"stateHash\":\"c6f71bba9c036ffc96d3930159c76e0d88161baeb4219b8e72415b74b80cfb8e\"}],\"cursor\":54,\"entries\":[{\"afterCheckpointId\":\"history.1d35e4c3f05f613b9ca623511bea0d38467624a7041ee5d0e66c15ea72fb3710\",\"barriers\":[],\"beforeCheckpointId\":\"history.959e9b4149e2aa4cb2ff07b5908ab18df45309ec21c065185682a379ff630d3c\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"background\",\"compensation\":null,\"descriptorId\":\"stmt_ui_1\",\"effectId\":\"effect.7bea3b086d22ec6647d5825fa8aa0788dd28400fb9a8eafa691e7df3be3f60c6\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"background.set\",\"logicalSequence\":0,\"originatingRevision\":1,\"payload\":{\"action\":\"set\",\"asset\":\"sample_station\"},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_1\"}],\"entryId\":\"entry.ab3a6a279304e5b701265d26c153004a36a20c0bca0dbb67c9b532101da9cfa5\",\"event\":{\"command\":\"background\",\"instructionId\":\"stmt_ui_1\",\"kind\":\"direction\",\"parameters\":{\"action\":\"set\",\"asset\":\"sample_station\"}},\"executedInstructions\":1,\"historyIndex\":0,\"input\":null},{\"afterCheckpointId\":\"history.0ba70f7d125eff50d5a1b31f48fa82b256a6f485ef151ac9e0b42acbaa1b60f7\",\"barriers\":[],\"beforeCheckpointId\":\"history.1d35e4c3f05f613b9ca623511bea0d38467624a7041ee5d0e66c15ea72fb3710\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.bgm\",\"compensation\":null,\"descriptorId\":\"stmt_ui_2\",\"effectId\":\"effect.7b401930c0dbad0482a14c9850cfb61eaf4b85b224e97a2311c4950798d56d04\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":1,\"originatingRevision\":2,\"payload\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_2\"}],\"entryId\":\"entry.79f75418148b96aeb6638e068c34088f0aa1b12f4e2ee28cf802627bea860fdb\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_2\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300}},\"executedInstructions\":1,\"historyIndex\":1,\"input\":null},{\"afterCheckpointId\":\"history.d4c39782082afa067e0e0999b6bb46081bf703e2520a832b03b1eebabfe44aad\",\"barriers\":[],\"beforeCheckpointId\":\"history.0ba70f7d125eff50d5a1b31f48fa82b256a6f485ef151ac9e0b42acbaa1b60f7\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.ambient\",\"compensation\":null,\"descriptorId\":\"stmt_ui_3\",\"effectId\":\"effect.2f327917a3cae2f4f48a18e65172558cc569ef18ca6c410a35204738dfd27f6f\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":2,\"originatingRevision\":3,\"payload\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_3\"}],\"entryId\":\"entry.eb1ea7d807d8a2be49b35a43405cf4e42f1322919833223b4fe341b44a17e818\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_3\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200}},\"executedInstructions\":1,\"historyIndex\":2,\"input\":null},{\"afterCheckpointId\":\"history.82e2acf507042ca294db18181ea77af0e7eed1889ee86690bac318ce59634412\",\"barriers\":[],\"beforeCheckpointId\":\"history.d4c39782082afa067e0e0999b6bb46081bf703e2520a832b03b1eebabfe44aad\",\"effects\":[],\"entryId\":\"entry.56d6be25d4130d6d93fa64586af9ac6d4a8b7394562772f1aefc9897eef67f14\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":3,\"input\":null},{\"afterCheckpointId\":\"history.921fd54896c4db073d708717d9492bcd3df66ffab41b6e944c90aff5328e4b08\",\"barriers\":[],\"beforeCheckpointId\":\"history.82e2acf507042ca294db18181ea77af0e7eed1889ee86690bac318ce59634412\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_4\",\"effectId\":\"effect.a3479116a02ee5fb25f696c889b0585ea3ab53ca7d24cebf352f644cfc6654af\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":3,\"originatingRevision\":5,\"payload\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_4\"}],\"entryId\":\"entry.16e896d68361691a51c1660837dfd6b70a72e356d1eef5491afdd89c29eee04e\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_4\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null},{\"afterCheckpointId\":\"history.4871c5b2de7ef8c67976d40c9a7269b1601bfc5383c06a2e329b8bce25d011d9\",\"barriers\":[],\"beforeCheckpointId\":\"history.921fd54896c4db073d708717d9492bcd3df66ffab41b6e944c90aff5328e4b08\",\"effects\":[],\"entryId\":\"entry.bd0b21d49605afcf9a8072a2dc7ffe29cf665b6e9be652544552810cdfbb5556\",\"event\":{\"instructionId\":\"stmt_ui_7\",\"kind\":\"narration\",\"text\":\"小夏不是来阻止他出发的。她在短信里只说，要把借了半年那本书还给他，顺便把书里的照片也还给他。林远原以为这是一件很容易的事：收下书，认真道谢，等广播响起后挥手。可当她撑着伞从街对面走来，他忽然不记得自己排练过的第一句话是什么了。\",\"textId\":\"txt_ui_8\"},\"executedInstructions\":1,\"historyIndex\":5,\"input\":null},{\"afterCheckpointId\":\"history.d7d8571f091098fe9976ed54ca524af651a49e909d641cdf07bc2f94c786d66a\",\"barriers\":[],\"beforeCheckpointId\":\"history.4871c5b2de7ef8c67976d40c9a7269b1601bfc5383c06a2e329b8bce25d011d9\",\"effects\":[],\"entryId\":\"entry.d7e20fc7b01da40e710b01b54b8d862c22fe5e1706138f8b3752869d51753a9e\",\"event\":{\"instructionId\":\"stmt_ui_9\",\"kind\":\"narration\",\"text\":\"照片上是一片没有拍到人的海。去年他们各自请了半天假，到了车站才知道列车停运，只能在便利店买两杯热饮，坐着听了一下午雨。后来小夏独自去了那片海，把拍下的照片寄给他，背面写着：没到的地方不必作废。林远把它夹进书里，每次搬家都带着，却一次也没有认真回复。\",\"textId\":\"txt_ui_10\"},\"executedInstructions\":1,\"historyIndex\":6,\"input\":null},{\"afterCheckpointId\":\"history.16f3db0173047ce6678b84f7e10bb546b6564bee758cd85b1344621bfca60ad2\",\"barriers\":[],\"beforeCheckpointId\":\"history.d7d8571f091098fe9976ed54ca524af651a49e909d641cdf07bc2f94c786d66a\",\"effects\":[],\"entryId\":\"entry.19e5132cee257706facde8955687fd93f3344c59e5ee559132a9b031b2bbfbd3\",\"event\":{\"instructionId\":\"stmt_ui_11\",\"kind\":\"narration\",\"text\":\"他想过许多合理的理由。项目赶进度，新工作的面试，还有一张要交房租的账单。生活确实忙，也确实不容易，可那些理由越整齐，他越清楚自己遗漏了什么：他在所有能回答的事情上回答得很快，只有在小夏问他想不想再约一次的时候，总是说等忙完这一阵。\",\"textId\":\"txt_ui_12\"},\"executedInstructions\":1,\"historyIndex\":7,\"input\":null},{\"afterCheckpointId\":\"history.56dc64bac0c6003c4a4645c1b0fd4b2ebc7a0c3f2da65eecc402432653fade2c\",\"barriers\":[],\"beforeCheckpointId\":\"history.16f3db0173047ce6678b84f7e10bb546b6564bee758cd85b1344621bfca60ad2\",\"effects\":[],\"entryId\":\"entry.462966cfdee820ad939cee9a6b2b7f26ac5db3e6b6e1edc2ee30cb7f21ce692a\",\"event\":{\"instructionId\":\"stmt_ui_13\",\"kind\":\"narration\",\"text\":\"站台的雨味让他想起那间租了三年的房间。窗边原本留着摆画架的位置，后来堆满了纸箱。他给这次换工作起名叫重新开始，仿佛只要把地址换掉，箱子里那些没画完的东西就会自己展开。小夏知道那些画，却从没催他交一张能被称作作品的结果。\",\"textId\":\"txt_ui_14\"},\"executedInstructions\":1,\"historyIndex\":8,\"input\":null},{\"afterCheckpointId\":\"history.ea7efc0d1c8454c453ac1da467123a44a093af171cb381a5eeaceafccf8b4e2e\",\"barriers\":[],\"beforeCheckpointId\":\"history.56dc64bac0c6003c4a4645c1b0fd4b2ebc7a0c3f2da65eecc402432653fade2c\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_6\",\"effectId\":\"effect.a961686d75907af320816209f7c9a38053dc276fa1b2a1411a9b1e53936d43c5\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":4,\"originatingRevision\":10,\"payload\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_6\"}],\"entryId\":\"entry.6bc35fb19a9a647d58d1bc06ee998323005910ab17384bf3dad31cdd6136719e\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_6\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":9,\"input\":null},{\"afterCheckpointId\":\"history.17eaca6a3105a9c2519abb89a93ee5aa0e126fab965cd19452500481ffcfe5ad\",\"barriers\":[],\"beforeCheckpointId\":\"history.ea7efc0d1c8454c453ac1da467123a44a093af171cb381a5eeaceafccf8b4e2e\",\"effects\":[],\"entryId\":\"entry.ffc1aba98557e3044ee67ce086b2e210b03ab33dfe0e7d280a3e3269d2033a38\",\"event\":{\"instructionId\":\"stmt_ui_15\",\"kind\":\"narration\",\"text\":\"“我带了另一件东西。”小夏从包里取出一个没有封口的信封，“本来约好明年再拆，可现在先给你也可以。”她没有把信塞到他手里，只放在他们中间的长椅上。信封被雨气浸得有一点软，林远盯着那个角，突然觉得自己不能再用赶车来结束今天的谈话。\",\"textId\":\"txt_ui_16\"},\"executedInstructions\":1,\"historyIndex\":10,\"input\":null},{\"afterCheckpointId\":\"history.c0be54f0cdee61815fc65f8f0cdaa73e22c28bb67ac25fbe95dc76442cac577a\",\"barriers\":[],\"beforeCheckpointId\":\"history.17eaca6a3105a9c2519abb89a93ee5aa0e126fab965cd19452500481ffcfe5ad\",\"effects\":[],\"entryId\":\"entry.4a3f9862f23eadff81bccb44c9e757cfb09084f23720e7e467946d02f9c2a925\",\"event\":{\"instructionId\":\"stmt_ui_17\",\"kind\":\"narration\",\"text\":\"列车晚点的通知替他们争来二十分钟。周围几个人抱怨了一声，又低头看手机；小夏却把伞靠在椅边，像是刚刚得到一张新的座位票。她问候车室是不是还开着。林远看向那扇亮着暖灯的门，点了点头，第一次主动把行李箱拉离检票线。\",\"textId\":\"txt_ui_18\"},\"executedInstructions\":1,\"historyIndex\":11,\"input\":null},{\"afterCheckpointId\":\"history.1ebe02bff55151c0b79a47c0de4e36c17ac10a3e5905f9b83c5237c73d4dfd02\",\"barriers\":[],\"beforeCheckpointId\":\"history.c0be54f0cdee61815fc65f8f0cdaa73e22c28bb67ac25fbe95dc76442cac577a\",\"effects\":[],\"entryId\":\"entry.5546fbfe2aca137e94e082a5d37cc595c27f5972502effb11ed785b1cb848d81\",\"event\":{\"instructionId\":\"stmt_ui_19\",\"kind\":\"narration\",\"text\":\"他们把湿外套抖了抖，没有立即谈信，也没有先给彼此一个结论。林远替她搬开椅上的报纸，小夏给他的书套上一个干燥的纸袋。原来愿意多停一会儿可以是这样小的一件事：承认话还没说完，并且真的坐下来，为它腾出时间。\",\"textId\":\"txt_ui_20\"},\"executedInstructions\":1,\"historyIndex\":12,\"input\":null},{\"afterCheckpointId\":\"history.7650c04c5cdd33dc0055232b35a1180a93a07b91f514076928c10fdfc8cd5dd9\",\"barriers\":[],\"beforeCheckpointId\":\"history.1ebe02bff55151c0b79a47c0de4e36c17ac10a3e5905f9b83c5237c73d4dfd02\",\"effects\":[],\"entryId\":\"entry.df1c467e90a07c789bf95cbf32ab8d3c8ece1584710ecf015c652de4fc26c7fc\",\"event\":{\"instructionId\":\"stmt_ui_21\",\"kind\":\"narration\",\"text\":\"走向候车室之前，林远给新公司的联系人写了一条消息，说列车晚点，预计到达时间会有变化。发送成功后，他收起手机，从长椅上捡起那封信。纸角已经有些湿了，他用掌心护着，抬头等小夏。\",\"textId\":\"txt_ui_22\"},\"executedInstructions\":1,\"historyIndex\":13,\"input\":null},{\"afterCheckpointId\":\"history.e1a51e1e132a608fac60831d0d50eb70f21947f1aad81247f893d131b67ec209\",\"barriers\":[],\"beforeCheckpointId\":\"history.7650c04c5cdd33dc0055232b35a1180a93a07b91f514076928c10fdfc8cd5dd9\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.voice\",\"compensation\":null,\"descriptorId\":\"stmt_ui_8\",\"effectId\":\"effect.f7303b9244a76e261207b88ea0ec2cebf7f7afa2a5dcec644817099766e29116\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":5,\"originatingRevision\":15,\"payload\":{\"action\":\"play\",\"asset\":\"voice_01\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_8\"}],\"entryId\":\"entry.94c1a0732eb3aa5792ab65b5e596a01aca16eb166761df6c036a30053fc5ab42\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_8\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"voice_01\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000}},\"executedInstructions\":1,\"historyIndex\":14,\"input\":null},{\"afterCheckpointId\":\"history.92734b15d85213f16dff5be1b0d4d3b76b4346e94133891f5168b790534a78d8\",\"barriers\":[],\"beforeCheckpointId\":\"history.e1a51e1e132a608fac60831d0d50eb70f21947f1aad81247f893d131b67ec209\",\"effects\":[],\"entryId\":\"entry.d28d25fcfa9c4e7c650e257fd2d85f350e2bceebe481afae1bc74062115d1d6a\",\"event\":{\"instructionId\":\"stmt_ui_25\",\"kind\":\"dialogue\",\"speakerId\":\"character_e3a0cb3de37d44b4\",\"text\":\"进去读吧。我想先把今天的话说完。\",\"textId\":\"txt_ui_26\"},\"executedInstructions\":1,\"historyIndex\":15,\"input\":null},{\"afterCheckpointId\":\"history.f2e4fddc85585b649c8596ead4e6ade160972b97974e238fd489f645a7fb0a01\",\"barriers\":[],\"beforeCheckpointId\":\"history.92734b15d85213f16dff5be1b0d4d3b76b4346e94133891f5168b790534a78d8\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.voice\",\"compensation\":null,\"descriptorId\":\"stmt_ui_10\",\"effectId\":\"effect.98d8a560575429e00b6170982238accd17864dacf41e91a034b212d3dc7f9d31\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.stop\",\"logicalSequence\":6,\"originatingRevision\":17,\"payload\":{\"action\":\"stop\",\"bus\":\"voice\"},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_10\"}],\"entryId\":\"entry.07de3470fa43daa845c02518e7fb281b5a3c4b6bea5b7a4d540f43c8d52a8140\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_10\",\"kind\":\"direction\",\"parameters\":{\"action\":\"stop\",\"bus\":\"voice\"}},\"executedInstructions\":1,\"historyIndex\":16,\"input\":null},{\"afterCheckpointId\":\"history.c04d22711f179366e27943f8f4a0619af369c7416adeec2a0e30b059f06274c3\",\"barriers\":[],\"beforeCheckpointId\":\"history.f2e4fddc85585b649c8596ead4e6ade160972b97974e238fd489f645a7fb0a01\",\"effects\":[],\"entryId\":\"entry.67b96f492c634d8ff8c06a51bf3b9ef1da6f7255cb99bad578ea602b45d5cec0\",\"event\":{\"instructionId\":\"stmt_ui_23\",\"kind\":\"narration\",\"text\":\"广播再一次提醒乘客留意车次。小夏应了一声，走在他前面推开候车室的门。林远拉着箱子跟进去。雨声被挡在玻璃外，仍然清晰；她把伞收进门边的桶里，替他留住快要合上的门。\",\"textId\":\"txt_ui_24\"},\"executedInstructions\":1,\"historyIndex\":17,\"input\":null},{\"afterCheckpointId\":\"history.4af412d08a023c860996a7baf1fdd44ff575e8063925e2a17456720269043ad0\",\"barriers\":[],\"beforeCheckpointId\":\"history.c04d22711f179366e27943f8f4a0619af369c7416adeec2a0e30b059f06274c3\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_fff36353633c42d1\",\"channel\":\"background\",\"compensation\":null,\"descriptorId\":\"stmt_ui_29\",\"effectId\":\"effect.f6fe09709ffcbdaa98bb3831ac24d7e7b90dafa9c5e812f893114e843f9942c5\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"background.set\",\"logicalSequence\":7,\"originatingRevision\":20,\"payload\":{\"action\":\"set\",\"asset\":\"waiting_room\",\"duration\":\"300ms\",\"transition\":\"fade\"},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_29\"}],\"entryId\":\"entry.3c1506ea47e05c5c79cd17e6e4fa0d5e44201a5ae207a56a7a589b81a3beeb87\",\"event\":{\"command\":\"background\",\"instructionId\":\"stmt_ui_29\",\"kind\":\"direction\",\"parameters\":{\"action\":\"set\",\"asset\":\"waiting_room\",\"duration\":\"300ms\",\"transition\":\"fade\"}},\"executedInstructions\":2,\"historyIndex\":18,\"input\":null},{\"afterCheckpointId\":\"history.7ee6b091eeaf2ebcba234b7b7dd921bf935fcad2d2f4eb3f213c4e52976edb60\",\"barriers\":[],\"beforeCheckpointId\":\"history.4af412d08a023c860996a7baf1fdd44ff575e8063925e2a17456720269043ad0\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_fff36353633c42d1\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_30\",\"effectId\":\"effect.cfed110514ca62535bdcbd304c50661e9b88e0317fbcc22fab598a560df9d160\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":8,\"originatingRevision\":21,\"payload\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_30\"}],\"entryId\":\"entry.81a57f40c20cc29b34bcf7332a754f107cff48424532e5ab06a489985ef92547\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_30\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":19,\"input\":null},{\"afterCheckpointId\":\"history.7bb60ac5211bc3ba554da372110b664bdf2730908f89dbafb94b644f3f8480d8\",\"barriers\":[],\"beforeCheckpointId\":\"history.7ee6b091eeaf2ebcba234b7b7dd921bf935fcad2d2f4eb3f213c4e52976edb60\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_fff36353633c42d1\",\"channel\":\"audio.ambient\",\"compensation\":null,\"descriptorId\":\"rain19_waiting_rain\",\"effectId\":\"effect.b17412be8114cce36204b00cc08945b023914b3e2f48abb7c54f07f0f470ff2e\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":9,\"originatingRevision\":22,\"payload\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":80},\"policy\":\"pure\",\"replayKey\":\"replay.rain19_waiting_rain\"}],\"entryId\":\"entry.3ddc67e477f23bafbd98a8b14e00c963d4d08d4f2a8dae3a5e7e177d24ddfc8a\",\"event\":{\"command\":\"audio\",\"instructionId\":\"rain19_waiting_rain\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":80}},\"executedInstructions\":1,\"historyIndex\":20,\"input\":null},{\"afterCheckpointId\":\"history.990c7b6d164d4aecd2113de3a9d467df9890f67e8defe2764f9f6963370b8269\",\"barriers\":[],\"beforeCheckpointId\":\"history.7bb60ac5211bc3ba554da372110b664bdf2730908f89dbafb94b644f3f8480d8\",\"effects\":[],\"entryId\":\"entry.315da381d73471786f1aa2d910aebc54f7568820e6764976f679d13788210bb6\",\"event\":{\"instructionId\":\"stmt_ui_31\",\"kind\":\"narration\",\"text\":\"候车室里只剩一排灯还亮着。小夏选了靠窗的两张椅子，隔着玻璃能看见站台上的信号灯。林远把箱子放在脚边，拆信前先问她是否介意读出声。她摇头，说如果有哪句让他不知道怎么接，也可以先停下来。信不是考试，不要求谁立刻给出正确答案。\",\"textId\":\"txt_ui_32\"},\"executedInstructions\":1,\"historyIndex\":21,\"input\":null},{\"afterCheckpointId\":\"history.fe9846b7bb21c68cedc4bbf44866b23c69ddf7ede89a2644dc414cf01b1b2369\",\"barriers\":[],\"beforeCheckpointId\":\"history.990c7b6d164d4aecd2113de3a9d467df9890f67e8defe2764f9f6963370b8269\",\"effects\":[],\"entryId\":\"entry.05d3150740f039a2045b2cd8a3a1678c3262e3996c27b22ea506286ff2c9d5bc\",\"event\":{\"instructionId\":\"stmt_ui_33\",\"kind\":\"narration\",\"text\":\"第一张纸写着他们错过海边列车那天的事。小夏记得林远把最后一杯热饮给了她，自己喝的那杯已经凉了。林远不记得自己做过这个选择，只记得那天一直没有想出该聊什么。他读到这里，才意识到有些在他看来失败的下午，在别人心里并没有那么糟。\",\"textId\":\"txt_ui_34\"},\"executedInstructions\":1,\"historyIndex\":22,\"input\":null},{\"afterCheckpointId\":\"history.79d856c607d72d0f581ecca3a4b16b652a0a7b87cdccbc60c5aa2266ea851ff5\",\"barriers\":[],\"beforeCheckpointId\":\"history.fe9846b7bb21c68cedc4bbf44866b23c69ddf7ede89a2644dc414cf01b1b2369\",\"effects\":[],\"entryId\":\"entry.f00e2f343e8c8076aee8ff736bebfbf8183e3a601d314d8db60da8b920679e30\",\"event\":{\"instructionId\":\"stmt_ui_35\",\"kind\":\"narration\",\"text\":\"第二张纸写得慢，字也比第一张小。她说自己换了一份工作，学着在下班后关掉群消息，不再把所有人的请求都算成必须马上完成的事。她也会害怕停下来，怕别人认为自己不够努力。但那天在车站，他说一班车的错过不等于一整天被浪费，她后来常想起这句话。\",\"textId\":\"txt_ui_36\"},\"executedInstructions\":1,\"historyIndex\":23,\"input\":null},{\"afterCheckpointId\":\"history.66dd7641d74c24558da01ba0d6637393bb2f89cd4f971d777796e367b0d1e64e\",\"barriers\":[],\"beforeCheckpointId\":\"history.79d856c607d72d0f581ecca3a4b16b652a0a7b87cdccbc60c5aa2266ea851ff5\",\"effects\":[],\"entryId\":\"entry.61b1c6b5afbb97a3570803699ecb429d1c0f8f03da667d9144cb59c9560149a5\",\"event\":{\"instructionId\":\"stmt_ui_37\",\"kind\":\"narration\",\"text\":\"林远把信放在膝盖上。他想说自己现在已经很少记得这么宽松地对待生活，想说那句话或许只是当时为了安慰她随口讲的。可小夏没有让他证明每句话都能坚持一辈子。她只问，今晚他还愿不愿意试着把那句话留给自己，不必先保证从此不再犹豫。\",\"textId\":\"txt_ui_38\"},\"executedInstructions\":1,\"historyIndex\":24,\"input\":null},{\"afterCheckpointId\":\"history.d7189e75a808c514a8e2c541e15bbde215a15b4a806d5e0009120e3c6354a988\",\"barriers\":[],\"beforeCheckpointId\":\"history.66dd7641d74c24558da01ba0d6637393bb2f89cd4f971d777796e367b0d1e64e\",\"effects\":[],\"entryId\":\"entry.ad6789dd81ea1248e69b35268152d59e0b17a2068712e3678d4b7269917a63ef\",\"event\":{\"instructionId\":\"stmt_ui_39\",\"kind\":\"narration\",\"text\":\"他告诉她新工作的合同并不是最后期限。对方愿意让他先做两周的试合作，也看过他画的草稿。这部分内容从来没出现在他讲给朋友的计划里；他总把计划讲成必须成功的一条直线，仿佛留下任何转弯，就会显得决心不够。说出来以后，那条线终于变得像一条真实的路。\",\"textId\":\"txt_ui_40\"},\"executedInstructions\":1,\"historyIndex\":25,\"input\":null},{\"afterCheckpointId\":\"history.4ed35524e6fcfe1373eb7cf70d20e76584c44c2b09d9001ec6c338f83c589e7c\",\"barriers\":[],\"beforeCheckpointId\":\"history.d7189e75a808c514a8e2c541e15bbde215a15b4a806d5e0009120e3c6354a988\",\"effects\":[],\"entryId\":\"entry.8725c3ab75264b2cd2004d5aaac91583135a473d00d3b4ad705fa35bd89ab7b5\",\"event\":{\"instructionId\":\"stmt_ui_41\",\"kind\":\"narration\",\"text\":\"小夏也有没说过的事。她申请了一个周末的课程，想学怎样修复旧书。第一堂课就在这个周末，她担心自己做不出什么像样的东西，又不愿意因为担心一直不报名。林远看着手里的信纸，第一次发现她并不是站在岸边等他回来的人，她也正在决定自己的出发。\",\"textId\":\"txt_ui_42\"},\"executedInstructions\":1,\"historyIndex\":26,\"input\":null},{\"afterCheckpointId\":\"history.841423682cdaa332b4add5c78a9b745275078b372ac32879d1897cd73d83fc05\",\"barriers\":[],\"beforeCheckpointId\":\"history.4ed35524e6fcfe1373eb7cf70d20e76584c44c2b09d9001ec6c338f83c589e7c\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_fff36353633c42d1\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_12\",\"effectId\":\"effect.dd4a87e0f24f90b40b287bfaf0bea36382ee06b96a00f19efab9a6d13333548c\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":10,\"originatingRevision\":29,\"payload\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_12\"}],\"entryId\":\"entry.b535c3116b5d0deb0955635dffbb6db43488864feda75cf0c08460e2ef48be87\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_12\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":27,\"input\":null},{\"afterCheckpointId\":\"history.1e2c14d7c490813501c3078beb3d74c3b924c91b68a38799f026436b905e65c1\",\"barriers\":[],\"beforeCheckpointId\":\"history.841423682cdaa332b4add5c78a9b745275078b372ac32879d1897cd73d83fc05\",\"effects\":[],\"entryId\":\"entry.fb43a6b212001fd2f60d8dd546cf01b758b9f47339234ea217936e3ae2530ec6\",\"event\":{\"instructionId\":\"stmt_ui_43\",\"kind\":\"narration\",\"text\":\"“所以你不需要为了我留下。”小夏说，“但也不用为了显得勇敢，什么都来不及安排就走。”她把旧照片翻到背面，指着那句没到的地方不必作废。那不是要他替去年补上一场旅行，而是提醒他们：一件事情可以继续，前提是两个人都愿意为它写下下一步。\",\"textId\":\"txt_ui_44\"},\"executedInstructions\":1,\"historyIndex\":28,\"input\":null},{\"afterCheckpointId\":\"history.42b944fb27de38da478bb1d6efdb8d50ff46e6db252d00a4542e9ba27fdf6a11\",\"barriers\":[],\"beforeCheckpointId\":\"history.1e2c14d7c490813501c3078beb3d74c3b924c91b68a38799f026436b905e65c1\",\"effects\":[],\"entryId\":\"entry.c6f3d7a77dcdc5ed12e94442866481fc1d3873a5f1acae873932501494a079eb\",\"event\":{\"instructionId\":\"stmt_ui_45\",\"kind\":\"narration\",\"text\":\"林远从包里找到一支快没墨的笔，在纸袋上写了两个日期。一个是试合作结束的那天，另一个是试合作结束后的第一个周末。他们并排看着，发现第二个日期两个人都可以空出来。小夏把笔推回他手边，等他把约定记进日历。\",\"textId\":\"txt_ui_46\"},\"executedInstructions\":1,\"historyIndex\":29,\"input\":null},{\"afterCheckpointId\":\"history.9013f28adb18b0bf4836f46db62b56b4958d205a705ff8eeb6ad8f760d744d6f\",\"barriers\":[],\"beforeCheckpointId\":\"history.42b944fb27de38da478bb1d6efdb8d50ff46e6db252d00a4542e9ba27fdf6a11\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_fff36353633c42d1\",\"channel\":\"audio.voice\",\"compensation\":null,\"descriptorId\":\"stmt_ui_14\",\"effectId\":\"effect.7a2bd064686c3013d674582335511f0874b9314a85c0ddb90b9dbe539ee3d8fc\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":11,\"originatingRevision\":32,\"payload\":{\"action\":\"play\",\"asset\":\"voice_02\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_14\"}],\"entryId\":\"entry.d4bd016e9ace5f0d74e04e7d80489790aa1837c5b554a0d47ae5b68991d28591\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_14\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"voice_02\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000}},\"executedInstructions\":1,\"historyIndex\":30,\"input\":null},{\"afterCheckpointId\":\"history.a44c449acea9ab2bcf89a4448d21cb40cbc88141f347cb1764b7bd17b15edef5\",\"barriers\":[],\"beforeCheckpointId\":\"history.9013f28adb18b0bf4836f46db62b56b4958d205a705ff8eeb6ad8f760d744d6f\",\"effects\":[],\"entryId\":\"entry.63a33231f608c13d8b19766fedca7b6d7288d7e7b314459f65974e2aedd9c86a\",\"event\":{\"instructionId\":\"stmt_ui_51\",\"kind\":\"dialogue\",\"speakerId\":\"character_2357b9a159834f77\",\"text\":\"把那个日期圈起来，变化了我们提前说。\",\"textId\":\"txt_ui_52\"},\"executedInstructions\":1,\"historyIndex\":31,\"input\":null},{\"afterCheckpointId\":\"history.b25170db81437f4866b8fa2fda508ce8493f78b9c3be9f06c660d82814f90102\",\"barriers\":[],\"beforeCheckpointId\":\"history.a44c449acea9ab2bcf89a4448d21cb40cbc88141f347cb1764b7bd17b15edef5\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_fff36353633c42d1\",\"channel\":\"audio.voice\",\"compensation\":null,\"descriptorId\":\"stmt_ui_16\",\"effectId\":\"effect.8703fc1bd2dced369e066763ffdcd4340022f70b470879b530636b5d929bfe5f\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.stop\",\"logicalSequence\":12,\"originatingRevision\":34,\"payload\":{\"action\":\"stop\",\"bus\":\"voice\"},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_16\"}],\"entryId\":\"entry.b7273df5d8898142adad027431ecc531f10a6f3c07f9ab84ff55c2c2c683b53b\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_16\",\"kind\":\"direction\",\"parameters\":{\"action\":\"stop\",\"bus\":\"voice\"}},\"executedInstructions\":1,\"historyIndex\":32,\"input\":null},{\"afterCheckpointId\":\"history.e7d0495dc09ea90f6469376b12be4fe6f2f1b7f154aa0905d0fd0ce478f64fc9\",\"barriers\":[],\"beforeCheckpointId\":\"history.b25170db81437f4866b8fa2fda508ce8493f78b9c3be9f06c660d82814f90102\",\"effects\":[],\"entryId\":\"entry.e7d0d112893c1caef2435f5ff9ca8ff730f54061f669cacb1f8e5fa4aa7da593\",\"event\":{\"instructionId\":\"stmt_ui_47\",\"kind\":\"narration\",\"text\":\"候车室的门开了，一对提着购物袋的老人进来避雨。林远给他们让出靠近暖气的位置，把自己的椅子挪到小夏旁边。信还剩最后一页，小夏说那页可以在路上读，也可以留到别的地方。林远重新把纸放进信封，觉得这一次不是拖延，而是知道故事还有可以抵达的地方。\",\"textId\":\"txt_ui_48\"},\"executedInstructions\":1,\"historyIndex\":33,\"input\":null},{\"afterCheckpointId\":\"history.60114e3dca3a8f08d831e6a5fedd11eea2ad31207e22b2891d39f7e2331b19a7\",\"barriers\":[],\"beforeCheckpointId\":\"history.e7d0495dc09ea90f6469376b12be4fe6f2f1b7f154aa0905d0fd0ce478f64fc9\",\"effects\":[],\"entryId\":\"entry.aeaf67224345dc4eb768d2001eb83b0dcee9ca81ba9f2d5d6ddabbd2efed660a\",\"event\":{\"instructionId\":\"stmt_ui_49\",\"kind\":\"narration\",\"text\":\"列车即将进站的提示亮在屏幕上。小夏站起来，把干燥的纸袋交还给他。他们没有说服彼此选同一条路，却已经知道无论林远今晚走不走，有几个约定都不必再等：回信，见面，还有把没完成的愿望告诉一个真正愿意听的人。\",\"textId\":\"txt_ui_50\"},\"executedInstructions\":1,\"historyIndex\":34,\"input\":null},{\"afterCheckpointId\":\"history.e8e8d5be273e6041eb0bf470b1e669188f0a506897cc5db9c72b0524fb907c4c\",\"barriers\":[],\"beforeCheckpointId\":\"history.60114e3dca3a8f08d831e6a5fedd11eea2ad31207e22b2891d39f7e2331b19a7\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_f3c19020bde744aa\",\"channel\":\"background\",\"compensation\":null,\"descriptorId\":\"stmt_ui_55\",\"effectId\":\"effect.dd862e969c5bbbef585ebabdd7f6ac71f7bb9860ed67736a5a6324af051fb646\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"background.set\",\"logicalSequence\":13,\"originatingRevision\":38,\"payload\":{\"action\":\"set\",\"asset\":\"sample_station\",\"duration\":\"300ms\",\"transition\":\"fade\"},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_55\"}],\"entryId\":\"entry.2ec7158265cf9a5fa601518e5c9bbc0be709788b0a2f9247279dfda1b20c5f1f\",\"event\":{\"command\":\"background\",\"instructionId\":\"stmt_ui_55\",\"kind\":\"direction\",\"parameters\":{\"action\":\"set\",\"asset\":\"sample_station\",\"duration\":\"300ms\",\"transition\":\"fade\"}},\"executedInstructions\":2,\"historyIndex\":35,\"input\":null},{\"afterCheckpointId\":\"history.4eee7922162709d70dfc8b8355b78683f477449cc5ed74ab4ae0fb9038cda894\",\"barriers\":[],\"beforeCheckpointId\":\"history.e8e8d5be273e6041eb0bf470b1e669188f0a506897cc5db9c72b0524fb907c4c\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_f3c19020bde744aa\",\"channel\":\"audio.sfx\",\"compensation\":null,\"descriptorId\":\"stmt_ui_57\",\"effectId\":\"effect.f3ef73da01dc52902b1567a603d6ea2e010ac151d205f28160300e2822a4bb8b\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":14,\"originatingRevision\":39,\"payload\":{\"action\":\"play\",\"asset\":\"station_chime\",\"bus\":\"sfx\",\"loop\":false,\"volumePermille\":350},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_57\"}],\"entryId\":\"entry.284ff8069b8c6544a20311f06bcceebc9b7c18f10de8d68f3c6102e9ee03841e\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_57\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"station_chime\",\"bus\":\"sfx\",\"loop\":false,\"volumePermille\":350}},\"executedInstructions\":1,\"historyIndex\":36,\"input\":null},{\"afterCheckpointId\":\"history.cae765e279e71c75727242ad2772228ece198bc202f8c9121b1a1ab165d7e1fc\",\"barriers\":[],\"beforeCheckpointId\":\"history.4eee7922162709d70dfc8b8355b78683f477449cc5ed74ab4ae0fb9038cda894\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_f3c19020bde744aa\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_59\",\"effectId\":\"effect.231e9bc019900dafa6b6fe2f53950e97b3b4dff6ff483959d367d29ebb89a2fd\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":15,\"originatingRevision\":40,\"payload\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_59\"}],\"entryId\":\"entry.5b3fa13b3e9e977ab37a614de31613b978a1a264498c3c7ccee33cc4a38f53ce\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_59\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":37,\"input\":null},{\"afterCheckpointId\":\"history.b6805fe867a8cebc55cedffb297f347934ae3ed5a166c9f8e6351277ed835139\",\"barriers\":[],\"beforeCheckpointId\":\"history.cae765e279e71c75727242ad2772228ece198bc202f8c9121b1a1ab165d7e1fc\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_f3c19020bde744aa\",\"channel\":\"audio.ambient\",\"compensation\":null,\"descriptorId\":\"rain19_platform_rain\",\"effectId\":\"effect.e73aae209fe80a0f7970ff66a2a04d5ef145041e6ec1c4257079d470b314396e\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":16,\"originatingRevision\":41,\"payload\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200},\"policy\":\"pure\",\"replayKey\":\"replay.rain19_platform_rain\"}],\"entryId\":\"entry.d561282671f4f36b29171994f570359fe75ac17d00b3d01c8c9055e00568ef89\",\"event\":{\"command\":\"audio\",\"instructionId\":\"rain19_platform_rain\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200}},\"executedInstructions\":1,\"historyIndex\":38,\"input\":null},{\"afterCheckpointId\":\"history.f68e087437010deacff773f8dc6c896e47b57d824f5ff49dbd945df5359b8acc\",\"barriers\":[],\"beforeCheckpointId\":\"history.b6805fe867a8cebc55cedffb297f347934ae3ed5a166c9f8e6351277ed835139\",\"effects\":[],\"entryId\":\"entry.1ea06ca67a25920b430df4145821835f80dc82040599690546b007b5ab3d5edd\",\"event\":{\"instructionId\":\"stmt_ui_61\",\"kind\":\"narration\",\"text\":\"推开门时，雨已经小了一些。车厢的灯从远处移过来，一节一节停在站台边。林远发现自己不再只是盯着时间：他看见推婴儿车的乘客需要绕开积水，看见值班员把一个打湿的指示牌重新扶正，也看见小夏松开伞柄，等着他把最后的话说完。\",\"textId\":\"txt_ui_62\"},\"executedInstructions\":1,\"historyIndex\":39,\"input\":null},{\"afterCheckpointId\":\"history.1c88f55386faa19a24be0f7f470f60e91af46d0f7d5003dc852b00cf55a50587\",\"barriers\":[],\"beforeCheckpointId\":\"history.f68e087437010deacff773f8dc6c896e47b57d824f5ff49dbd945df5359b8acc\",\"effects\":[],\"entryId\":\"entry.6a67569c5c395b8daf4b323f890e2a38b004e24b97079d99ad1a153987d8fdc0\",\"event\":{\"instructionId\":\"stmt_ui_63\",\"kind\":\"narration\",\"text\":\"他问她，如果今晚不上车，明天是不是就会后悔。小夏想了想，说可能会，所以留下也需要一个理由，不能只把明天交给今天的感动。她问他想留下做什么。林远没有说为你，他说想把那份试合作的计划整理完，想和她好好吃一顿饭，把回信写到能够寄出的程度。\",\"textId\":\"txt_ui_64\"},\"executedInstructions\":1,\"historyIndex\":40,\"input\":null},{\"afterCheckpointId\":\"history.ec55794fe6c36d5f96b0ffeeb1a1bf510d167acd09d75c20f3205761fda32862\",\"barriers\":[],\"beforeCheckpointId\":\"history.1c88f55386faa19a24be0f7f470f60e91af46d0f7d5003dc852b00cf55a50587\",\"effects\":[],\"entryId\":\"entry.16f7cf0b86b446408da590a9dfd9e86f37da6d948cff78a82468e5528a618586\",\"event\":{\"instructionId\":\"stmt_ui_65\",\"kind\":\"narration\",\"text\":\"“那走呢？”她继续问。林远说，走就带着这些事情去做，而不是到新地方以后再假装它们都已经解决。他想在列车上读完最后一页，到了之后告诉她实际的样子。可能没有照片那么漂亮，也可能不会立刻成功，但他愿意讲过程，不再只交一份报喜的结果。\",\"textId\":\"txt_ui_66\"},\"executedInstructions\":1,\"historyIndex\":41,\"input\":null},{\"afterCheckpointId\":\"history.997c571ca3e3c48b41cacffd1c3975eee61b98fb3c5c1b925f7358187ac3dc34\",\"barriers\":[],\"beforeCheckpointId\":\"history.ec55794fe6c36d5f96b0ffeeb1a1bf510d167acd09d75c20f3205761fda32862\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_f3c19020bde744aa\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_18\",\"effectId\":\"effect.7da6202fa82cf72ce041158d9bfeffcd36539623302e6913c1bc368fe60cb3a8\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":17,\"originatingRevision\":45,\"payload\":{\"action\":\"show\",\"asset\":\"xia_smile\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_18\"}],\"entryId\":\"entry.d4783df6c96e7f49ceed82eea171c8486f0b7074194574b63b54577678f72ae7\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_18\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_smile\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":42,\"input\":null},{\"afterCheckpointId\":\"history.255cde0d90c02196baa29d7cdcfac140afd3d08df19802cdbf4cdd5bb732a492\",\"barriers\":[],\"beforeCheckpointId\":\"history.997c571ca3e3c48b41cacffd1c3975eee61b98fb3c5c1b925f7358187ac3dc34\",\"effects\":[],\"entryId\":\"entry.7db44d5ac69d6a704f13e60a3c3daf3ec07a6d4d9415bb7fb314167f7fbffd7a\",\"event\":{\"instructionId\":\"stmt_ui_67\",\"kind\":\"narration\",\"text\":\"小夏笑了一下。她说两种答案都比一句等以后更具体。她没有因为其中一条路会让今晚长一点，就把另一条路说成错误。林远明白自己真正要选的，并不是哪条路没有代价，而是哪一种代价他愿意认真承担，并且愿意在事情变化时重新说明。\",\"textId\":\"txt_ui_68\"},\"executedInstructions\":1,\"historyIndex\":43,\"input\":null},{\"afterCheckpointId\":\"history.006c41c9511005667b0ee188a2808fc875212d59907a3a3fd4ad72ab4d452433\",\"barriers\":[],\"beforeCheckpointId\":\"history.255cde0d90c02196baa29d7cdcfac140afd3d08df19802cdbf4cdd5bb732a492\",\"effects\":[],\"entryId\":\"entry.5480dc1d162efd5eb1c2fd37cc20cf67d3784ae254c773e282cddf998ddfd099\",\"event\":{\"instructionId\":\"stmt_ui_69\",\"kind\":\"narration\",\"text\":\"检票声在他们身后响起。小夏把伞收好，伞尖滴下来的水在地上连成小小的一圈。她问他还需要几分钟。林远说不用再等广播替他决定了。她后退半步，把检票口和车站出口都留在他的视线里；他仍能看见她，但不必越过她才抵达其中任何一个方向。\",\"textId\":\"txt_ui_70\"},\"executedInstructions\":1,\"historyIndex\":44,\"input\":null},{\"afterCheckpointId\":\"history.27499f9c1c7a24545b362b268a6157e0997cba3d7e4d4339a17f6c0c20877db6\",\"barriers\":[],\"beforeCheckpointId\":\"history.006c41c9511005667b0ee188a2808fc875212d59907a3a3fd4ad72ab4d452433\",\"effects\":[],\"entryId\":\"entry.8dd20e186b622c041d35eb7ca9a4ae2de6d43eaa952e5c0ad635d4d179e6b1d4\",\"event\":{\"instructionId\":\"stmt_ui_71\",\"kind\":\"narration\",\"text\":\"林远给母亲发了一条简短消息，告诉她自己已经到站，之后的安排会再联系。他原本以为这是一场必须独自完成的选择，可当他把几个关心自己的人放回这件事里，事情并没有变得更难。真正难的是承认选择之后还需要很多普通的解释，而不是一场戏剧性的宣告。\",\"textId\":\"txt_ui_72\"},\"executedInstructions\":1,\"historyIndex\":45,\"input\":null},{\"afterCheckpointId\":\"history.317303dc38bb57d4dca14e8f212603f3852bd7d362dc9f35f2c62af9df7cf004\",\"barriers\":[],\"beforeCheckpointId\":\"history.27499f9c1c7a24545b362b268a6157e0997cba3d7e4d4339a17f6c0c20877db6\",\"effects\":[],\"entryId\":\"entry.5e1ff93bb19a6ad56e8e6ceccd3d3c0f8af5de620cd2eb39e249cdbf4dc741a0\",\"event\":{\"instructionId\":\"stmt_ui_73\",\"kind\":\"narration\",\"text\":\"小夏最后确认了一次日历上圈起的日期。他们约定那天无论在哪里，都先给对方留出一个完整的下午。如果工作有变，提前说；如果路上遇到困难，也不用等困难结束。她把这些话说得像在约一顿饭，不像要求一个人的未来从此不能偏航。\",\"textId\":\"txt_ui_74\"},\"executedInstructions\":1,\"historyIndex\":46,\"input\":null},{\"afterCheckpointId\":\"history.703d6c20313992aa2234a417ee8ae74ffd9589ddfa1dd67d7013ae01d6b68864\",\"barriers\":[],\"beforeCheckpointId\":\"history.317303dc38bb57d4dca14e8f212603f3852bd7d362dc9f35f2c62af9df7cf004\",\"effects\":[],\"entryId\":\"entry.42b4a0edc6a8d8fbd45f5350b11517a12ef9aaccc518ca32772548dd1d3565de\",\"event\":{\"instructionId\":\"stmt_ui_75\",\"kind\":\"narration\",\"text\":\"列车门保持开着。林远看见里面有一张空座位，车站外的面馆也还亮着灯。两边都不是一张保证书，都可能有疲倦、误会和需要重新安排的明天。他捏着信封的边，想起小夏说的那句不是考试，终于允许自己在没有确定一切的时候，作出一个清楚的决定。\",\"textId\":\"txt_ui_76\"},\"executedInstructions\":1,\"historyIndex\":47,\"input\":null},{\"afterCheckpointId\":\"history.1da9f5056db188bf782d5a28a9dbbe234b0fed6e3fa016217f4c9a197894d2ed\",\"barriers\":[],\"beforeCheckpointId\":\"history.703d6c20313992aa2234a417ee8ae74ffd9589ddfa1dd67d7013ae01d6b68864\",\"effects\":[],\"entryId\":\"entry.3279b84893a60fd632ee275aaf560d5bd11c3b179abc5895ac5c23794c36b741\",\"event\":{\"instructionId\":\"stmt_ui_77\",\"kind\":\"narration\",\"text\":\"“无论今晚在哪儿，到了就发消息。”小夏说。林远点头。他把那本书收进背包，没有再把信夹到最深的地方。这次它就在伸手能拿到的位置，提醒他选择不是用来结束谈话的句号，而是让下一封信有地址的一行字。\",\"textId\":\"txt_ui_78\"},\"executedInstructions\":1,\"historyIndex\":48,\"input\":null},{\"afterCheckpointId\":\"history.418426f67d9c8a2e7aff16760d3d3075a35b9d181bbb560557afd9b87c37626c\",\"barriers\":[],\"beforeCheckpointId\":\"history.1da9f5056db188bf782d5a28a9dbbe234b0fed6e3fa016217f4c9a197894d2ed\",\"effects\":[],\"entryId\":\"entry.0bcbf076b4a150aee860b16db8f7b46d88c1264ae8f50768889220ede4f7884c\",\"event\":{\"instructionId\":\"stmt_ui_79\",\"kind\":\"narration\",\"text\":\"雨声渐渐远了，检票员请剩下的乘客准备上车。林远看着小夏，又看向灯下的两个方向。他知道自己不能一直站在它们之间，也知道走向其中一个，并不需要把另一个人从故事里删掉。现在，他准备回答了。\",\"textId\":\"txt_ui_80\"},\"executedInstructions\":1,\"historyIndex\":49,\"input\":null},{\"afterCheckpointId\":\"history.49649cf828bac5bc029e23b6c8c0d241d8b927fff53e531a056cd91aeb15fc57\",\"barriers\":[],\"beforeCheckpointId\":\"history.418426f67d9c8a2e7aff16760d3d3075a35b9d181bbb560557afd9b87c37626c\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_f3c19020bde744aa\",\"channel\":\"audio.voice\",\"compensation\":null,\"descriptorId\":\"stmt_ui_20\",\"effectId\":\"effect.435165d414d023203b4e101ab8653858d4b6bbab30b9ccb979dd863a9bda0558\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":18,\"originatingRevision\":53,\"payload\":{\"action\":\"play\",\"asset\":\"voice_03\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_20\"}],\"entryId\":\"entry.2368933490f63405d9835959a72dcd7df02c488012ff4f83671b723f4ce8a6b5\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_20\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"voice_03\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000}},\"executedInstructions\":1,\"historyIndex\":50,\"input\":null},{\"afterCheckpointId\":\"history.0d1688cad4c4c13eda329c85017615af4e357ac005bfd0324357ec17a7b9ae1f\",\"barriers\":[],\"beforeCheckpointId\":\"history.49649cf828bac5bc029e23b6c8c0d241d8b927fff53e531a056cd91aeb15fc57\",\"effects\":[],\"entryId\":\"entry.aa051a3f0133f7fe36e5c4a646ab2cece38b9a8130468ac53a61e0cf221f125e\",\"event\":{\"instructionId\":\"stmt_ui_81\",\"kind\":\"dialogue\",\"speakerId\":\"character_e3a0cb3de37d44b4\",\"text\":\"这次我不会只回答一句以后。\",\"textId\":\"txt_ui_82\"},\"executedInstructions\":1,\"historyIndex\":51,\"input\":null},{\"afterCheckpointId\":\"history.737311e807818f56e9d76e7a7eb009e33f326ddc89f866af6edf69703d7282cf\",\"barriers\":[],\"beforeCheckpointId\":\"history.0d1688cad4c4c13eda329c85017615af4e357ac005bfd0324357ec17a7b9ae1f\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_f3c19020bde744aa\",\"channel\":\"audio.voice\",\"compensation\":null,\"descriptorId\":\"stmt_ui_22\",\"effectId\":\"effect.240aa36fc49b379320d1da3029b9ce93b81457b445c9b0b2158c02c4be778a1b\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.stop\",\"logicalSequence\":19,\"originatingRevision\":55,\"payload\":{\"action\":\"stop\",\"bus\":\"voice\"},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_22\"}],\"entryId\":\"entry.589a1027b3927e3a39e38d2a700bc69c34eec7088353e5e42c1b2c529679f531\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_22\",\"kind\":\"direction\",\"parameters\":{\"action\":\"stop\",\"bus\":\"voice\"}},\"executedInstructions\":1,\"historyIndex\":52,\"input\":null},{\"afterCheckpointId\":\"history.c6f71bba9c036ffc96d3930159c76e0d88161baeb4219b8e72415b74b80cfb8e\",\"barriers\":[],\"beforeCheckpointId\":\"history.737311e807818f56e9d76e7a7eb009e33f326ddc89f866af6edf69703d7282cf\",\"effects\":[],\"entryId\":\"entry.96f46e2e61551c0e6e9ab69279e461401a367fc33b04029c709e233f4a2ac32d\",\"event\":{\"instructionId\":\"stmt_ui_83\",\"kind\":\"choice\",\"options\":[{\"label\":\"今晚留下，把回信写完\",\"optionId\":\"option_ui_85\",\"targetSceneId\":\"scene_e919f09d3b7d45f7\"},{\"label\":\"今晚出发，在路上继续\",\"optionId\":\"option_ui_86\",\"targetSceneId\":\"scene_f4bf99fd319a40a4\"}],\"prompt\":\"最后一班车到了，你准备怎样继续这个约定？\"},\"executedInstructions\":1,\"historyIndex\":53,\"input\":null}],\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"65436954731c4bc27172faaae2d85d422370930e97a1be0882f781d533aae7fb\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":"","origin":"current"},"sha256":"de1416986d8ce341fde8e74baeb50e5f78b2322f0f80da00cb3915d226ddba13"}
82a379ff630d3c\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"background\",\"compensation\":null,\"descriptorId\":\"stmt_ui_1\",\"effectId\":\"effect.7bea3b086d22ec6647d5825fa8aa0788dd28400fb9a8eafa691e7df3be3f60c6\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"background.set\",\"logicalSequence\":0,\"originatingRevision\":1,\"payload\":{\"action\":\"set\",\"asset\":\"sample_station\"},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_1\"}],\"entryId\":\"entry.ab3a6a279304e5b701265d26c153004a36a20c0bca0dbb67c9b532101da9cfa5\",\"event\":{\"command\":\"background\",\"instructionId\":\"stmt_ui_1\",\"kind\":\"direction\",\"parameters\":{\"action\":\"set\",\"asset\":\"sample_station\"}},\"executedInstructions\":1,\"historyIndex\":0,\"input\":null},{\"afterCheckpointId\":\"history.0ba70f7d125eff50d5a1b31f48fa82b256a6f485ef151ac9e0b42acbaa1b60f7\",\"barriers\":[],\"beforeCheckpointId\":\"history.1d35e4c3f05f613b9ca623511bea0d38467624a7041ee5d0e66c15ea72fb3710\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.bgm\",\"compensation\":null,\"descriptorId\":\"stmt_ui_2\",\"effectId\":\"effect.7b401930c0dbad0482a14c9850cfb61eaf4b85b224e97a2311c4950798d56d04\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":1,\"originatingRevision\":2,\"payload\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_2\"}],\"entryId\":\"entry.79f75418148b96aeb6638e068c34088f0aa1b12f4e2ee28cf802627bea860fdb\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_2\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300}},\"executedInstructions\":1,\"historyIndex\":1,\"input\":null},{\"afterCheckpointId\":\"history.d4c39782082afa067e0e0999b6bb46081bf703e2520a832b03b1eebabfe44aad\",\"barriers\":[],\"beforeCheckpointId\":\"history.0ba70f7d125eff50d5a1b31f48fa82b256a6f485ef151ac9e0b42acbaa1b60f7\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.ambient\",\"compensation\":null,\"descriptorId\":\"stmt_ui_3\",\"effectId\":\"effect.2f327917a3cae2f4f48a18e65172558cc569ef18ca6c410a35204738dfd27f6f\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":2,\"originatingRevision\":3,\"payload\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_3\"}],\"entryId\":\"entry.eb1ea7d807d8a2be49b35a43405cf4e42f1322919833223b4fe341b44a17e818\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_3\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200}},\"executedInstructions\":1,\"historyIndex\":2,\"input\":null},{\"afterCheckpointId\":\"history.82e2acf507042ca294db18181ea77af0e7eed1889ee86690bac318ce59634412\",\"barriers\":[],\"beforeCheckpointId\":\"history.d4c39782082afa067e0e0999b6bb46081bf703e2520a832b03b1eebabfe44aad\",\"effects\":[],\"entryId\":\"entry.56d6be25d4130d6d93fa64586af9ac6d4a8b7394562772f1aefc9897eef67f14\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":3,\"input\":null},{\"afterCheckpointId\":\"history.921fd54896c4db073d708717d9492bcd3df66ffab41b6e944c90aff5328e4b08\",\"barriers\":[],\"beforeCheckpointId\":\"history.82e2acf507042ca294db18181ea77af0e7eed1889ee86690bac318ce59634412\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_4\",\"effectId\":\"effect.a3479116a02ee5fb25f696c889b0585ea3ab53ca7d24cebf352f644cfc6654af\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":3,\"originatingRevision\":5,\"payload\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_4\"}],\"entryId\":\"entry.16e896d68361691a51c1660837dfd6b70a72e356d1eef5491afdd89c29eee04e\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_4\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null},{\"afterCheckpointId\":\"history.4871c5b2de7ef8c67976d40c9a7269b1601bfc5383c06a2e329b8bce25d011d9\",\"barriers\":[],\"beforeCheckpointId\":\"history.921fd54896c4db073d708717d9492bcd3df66ffab41b6e944c90aff5328e4b08\",\"effects\":[],\"entryId\":\"entry.bd0b21d49605afcf9a8072a2dc7ffe29cf665b6e9be652544552810cdfbb5556\",\"event\":{\"instructionId\":\"stmt_ui_7\",\"kind\":\"narration\",\"text\":\"小夏不是来阻止他出发的。她在短信里只说，要把借了半年那本书还给他，顺便把书里的照片也还给他。林远原以为这是一件很容易的事：收下书，认真道谢，等广播响起后挥手。可当她撑着伞从街对面走来，他忽然不记得自己排练过的第一句话是什么了。\",\"textId\":\"txt_ui_8\"},\"executedInstructions\":1,\"historyIndex\":5,\"input\":null},{\"afterCheckpointId\":\"history.d7d8571f091098fe9976ed54ca524af651a49e909d641cdf07bc2f94c786d66a\",\"barriers\":[],\"beforeCheckpointId\":\"history.4871c5b2de7ef8c67976d40c9a7269b1601bfc5383c06a2e329b8bce25d011d9\",\"effects\":[],\"entryId\":\"entry.d7e20fc7b01da40e710b01b54b8d862c22fe5e1706138f8b3752869d51753a9e\",\"event\":{\"instructionId\":\"stmt_ui_9\",\"kind\":\"narration\",\"text\":\"照片上是一片没有拍到人的海。去年他们各自请了半天假，到了车站才知道列车停运，只能在便利店买两杯热饮，坐着听了一下午雨。后来小夏独自去了那片海，把拍下的照片寄给他，背面写着：没到的地方不必作废。林远把它夹进书里，每次搬家都带着，却一次也没有认真回复。\",\"textId\":\"txt_ui_10\"},\"executedInstructions\":1,\"historyIndex\":6,\"input\":null},{\"afterCheckpointId\":\"history.16f3db0173047ce6678b84f7e10bb546b6564bee758cd85b1344621bfca60ad2\",\"barriers\":[],\"beforeCheckpointId\":\"history.d7d8571f091098fe9976ed54ca524af651a49e909d641cdf07bc2f94c786d66a\",\"effects\":[],\"entryId\":\"entry.19e5132cee257706facde8955687fd93f3344c59e5ee559132a9b031b2bbfbd3\",\"event\":{\"instructionId\":\"stmt_ui_11\",\"kind\":\"narration\",\"text\":\"他想过许多合理的理由。项目赶进度，新工作的面试，还有一张要交房租的账单。生活确实忙，也确实不容易，可那些理由越整齐，他越清楚自己遗漏了什么：他在所有能回答的事情上回答得很快，只有在小夏问他想不想再约一次的时候，总是说等忙完这一阵。\",\"textId\":\"txt_ui_12\"},\"executedInstructions\":1,\"historyIndex\":7,\"input\":null},{\"afterCheckpointId\":\"history.56dc64bac0c6003c4a4645c1b0fd4b2ebc7a0c3f2da65eecc402432653fade2c\",\"barriers\":[],\"beforeCheckpointId\":\"history.16f3db0173047ce6678b84f7e10bb546b6564bee758cd85b1344621bfca60ad2\",\"effects\":[],\"entryId\":\"entry.462966cfdee820ad939cee9a6b2b7f26ac5db3e6b6e1edc2ee30cb7f21ce692a\",\"event\":{\"instructionId\":\"stmt_ui_13\",\"kind\":\"narration\",\"text\":\"站台的雨味让他想起那间租了三年的房间。窗边原本留着摆画架的位置，后来堆满了纸箱。他给这次换工作起名叫重新开始，仿佛只要把地址换掉，箱子里那些没画完的东西就会自己展开。小夏知道那些画，却从没催他交一张能被称作作品的结果。\",\"textId\":\"txt_ui_14\"},\"executedInstructions\":1,\"historyIndex\":8,\"input\":null},{\"afterCheckpointId\":\"history.ea7efc0d1c8454c453ac1da467123a44a093af171cb381a5eeaceafccf8b4e2e\",\"barriers\":[],\"beforeCheckpointId\":\"history.56dc64bac0c6003c4a4645c1b0fd4b2ebc7a0c3f2da65eecc402432653fade2c\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_6\",\"effectId\":\"effect.a961686d75907af320816209f7c9a38053dc276fa1b2a1411a9b1e53936d43c5\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"show.show\",\"logicalSequence\":4,\"originatingRevision\":10,\"payload\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_6\"}],\"entryId\":\"entry.6bc35fb19a9a647d58d1bc06ee998323005910ab17384bf3dad31cdd6136719e\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_6\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":9,\"input\":null},{\"afterCheckpointId\":\"history.17eaca6a3105a9c2519abb89a93ee5aa0e126fab965cd19452500481ffcfe5ad\",\"barriers\":[],\"beforeCheckpointId\":\"history.ea7efc0d1c8454c453ac1da467123a44a093af171cb381a5eeaceafccf8b4e2e\",\"effects\":[],\"entryId\":\"entry.ffc1aba98557e3044ee67ce086b2e210b03ab33dfe0e7d280a3e3269d2033a38\",\"event\":{\"instructionId\":\"stmt_ui_15\",\"kind\":\"narration\",\"text\":\"“我带了另一件东西。”小夏从包里取出一个没有封口的信封，“本来约好明年再拆，可现在先给你也可以。”她没有把信塞到他手里，只放在他们中间的长椅上。信封被雨气浸得有一点软，林远盯着那个角，突然觉得自己不能再用赶车来结束今天的谈话。\",\"textId\":\"txt_ui_16\"},\"executedInstructions\":1,\"historyIndex\":10,\"input\":null},{\"afterCheckpointId\":\"history.c0be54f0cdee61815fc65f8f0cdaa73e22c28bb67ac25fbe95dc76442cac577a\",\"barriers\":[],\"beforeCheckpointId\":\"history.17eaca6a3105a9c2519abb89a93ee5aa0e126fab965cd19452500481ffcfe5ad\",\"effects\":[],\"entryId\":\"entry.4a3f9862f23eadff81bccb44c9e757cfb09084f23720e7e467946d02f9c2a925\",\"event\":{\"instructionId\":\"stmt_ui_17\",\"kind\":\"narration\",\"text\":\"列车晚点的通知替他们争来二十分钟。周围几个人抱怨了一声，又低头看手机；小夏却把伞靠在椅边，像是刚刚得到一张新的座位票。她问候车室是不是还开着。林远看向那扇亮着暖灯的门，点了点头，第一次主动把行李箱拉离检票线。\",\"textId\":\"txt_ui_18\"},\"executedInstructions\":1,\"historyIndex\":11,\"input\":null},{\"afterCheckpointId\":\"history.1ebe02bff55151c0b79a47c0de4e36c17ac10a3e5905f9b83c5237c73d4dfd02\",\"barriers\":[],\"beforeCheckpointId\":\"history.c0be54f0cdee61815fc65f8f0cdaa73e22c28bb67ac25fbe95dc76442cac577a\",\"effects\":[],\"entryId\":\"entry.5546fbfe2aca137e94e082a5d37cc595c27f5972502effb11ed785b1cb848d81\",\"event\":{\"instructionId\":\"stmt_ui_19\",\"kind\":\"narration\",\"text\":\"他们把湿外套抖了抖，没有立即谈信，也没有先给彼此一个结论。林远替她搬开椅上的报纸，小夏给他的书套上一个干燥的纸袋。原来愿意多停一会儿可以是这样小的一件事：承认话还没说完，并且真的坐下来，为它腾出时间。\",\"textId\":\"txt_ui_20\"},\"executedInstructions\":1,\"historyIndex\":12,\"input\":null},{\"afterCheckpointId\":\"history.7650c04c5cdd33dc0055232b35a1180a93a07b91f514076928c10fdfc8cd5dd9\",\"barriers\":[],\"beforeCheckpointId\":\"history.1ebe02bff55151c0b79a47c0de4e36c17ac10a3e5905f9b83c5237c73d4dfd02\",\"effects\":[],\"entryId\":\"entry.df1c467e90a07c789bf95cbf32ab8d3c8ece1584710ecf015c652de4fc26c7fc\",\"event\":{\"instructionId\":\"stmt_ui_21\",\"kind\":\"narration\",\"text\":\"走向候车室之前，林远给新公司的联系人写了一条消息，说列车晚点，预计到达时间会有变化。发送成功后，他收起手机，从长椅上捡起那封信。纸角已经有些湿了，他用掌心护着，抬头等小夏。\",\"textId\":\"txt_ui_22\"},\"executedInstructions\":1,\"historyIndex\":13,\"input\":null},{\"afterCheckpointId\":\"history.e1a51e1e132a608fac60831d0d50eb70f21947f1aad81247f893d131b67ec209\",\"barriers\":[],\"beforeCheckpointId\":\"history.7650c04c5cdd33dc0055232b35a1180a93a07b91f514076928c10fdfc8cd5dd9\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.voice\",\"compensation\":null,\"descriptorId\":\"stmt_ui_8\",\"effectId\":\"effect.f7303b9244a76e261207b88ea0ec2cebf7f7afa2a5dcec644817099766e29116\",\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"kind\":\"audio.play\",\"logicalSequence\":5,\"originatingRevision\":15,\"payload\":{\"action\":\"play\",\"asset\":\"voice_01\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_8\"}],\"entryId\":\"entry.94c1a0732eb3aa5792ab65b5e596a01aca16eb166761df6c036a30053fc5ab42\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_8\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"voice_01\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000}},\"executedInstructions\":1,\"historyIndex\":14,\"input\":null},{\"afterCheckpointId\":\"history.92734b15d85213f16dff5be1b0d4d3b76b4346e94133891f5168b790534a78d8\",\"barriers\":[],\"beforeCheckpointId\":\"history.e1a51e1e132a608fac60831d0d50eb70f21947f1aad81247f893d131b67ec209\",\"effects\":[],\"entryId\":\"entry.d28d25fcfa9c4e7c650e257fd2d85f350e2bceebe481afae1bc74062115d1d6a\",\"event\":{\"instructionId\":\"stmt_ui_25\",\"kind\":\"dialogue\",\"speakerId\":\"character_e3a0cb3de37d44b4\",\"text\":\"进去读吧。我想先把今天的话说完。\",\"textId\":\"txt_ui_26\"},\"executedInstructions\":1,\"historyIndex\":15,\"input\":null}],\"executionId\":\"player.e1de8f8e2a345cbc8157a90e\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"58332f2fbcdfa8b6ae6c227470119f01e6efc96eae537529b0579453bfa9f078\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":"","origin":"current"},"sha256":"60cb7c9fd4460713302fe299c18a5ff8ea02fb98f77b3004286bed4b57d89b2f"}
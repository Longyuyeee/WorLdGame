  "bindings": [
    {
      "assetId": "voice_01",
      "scene": "车站的雨",
      "statementId": "stmt_ui_25",
      "text": "进去读吧。我想先把今天的话说完。",
      "speaker": "林远",
      "file": "voice-01.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    },
    {
      "assetId": "voice_02",
      "scene": "候车室的旧信",
      "statementId": "stmt_ui_51",
      "text": "把那个日期圈起来，变化了我们提前说。",
      "speaker": "小夏",
      "file": "voice-02.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    },
    {
      "assetId": "voice_03",
      "scene": "站台前的约定",
      "statementId": "stmt_ui_81",
      "text": "这次我不会只回答一句以后。",
      "speaker": "林远",
      "file": "voice-03.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    },
    {
      "assetId": "voice_04",
      "scene": "留下",
      "statementId": "stmt_ui_113",
      "text": "出发的事明早确认，今晚的回信不用再等。",
      "speaker": "林远",
      "file": "voice-04-v1.7.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    },
    {
      "assetId": "voice_05",
      "scene": "灯下的回信",
      "statementId": "stmt_ui_139",
      "text": "信可以有下一封，闹钟也记得设好。",
      "speaker": "小夏",
      "file": "voice-05.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    },
    {
      "assetId": "voice_06",
      "scene": "雨后的天明",
      "statementId": "stmt_ui_167",
      "text": "到了就告诉我实际的样子，不用只讲顺利的事。",
      "speaker": "小夏",
      "file": "voice-06.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    },
    {
      "assetId": "voice_07",
      "scene": "远行",
      "statementId": "stmt_ui_196",
      "text": "先吃一顿热饭，信里的故事慢慢回。",
      "speaker": "小夏",
      "file": "voice-07.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    },
    {
      "assetId": "voice_08",
      "scene": "车窗与海",
      "statementId": "stmt_ui_223",
      "text": "下次一起走这条路，我们穿舒服的鞋。",
      "speaker": "林远",
      "file": "voice-08.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    },
    {
      "assetId": "voice_09",
      "scene": "再一次见面",
      "statementId": "stmt_ui_250",
      "text": "我们有时间，把上次的故事继续讲完。",
      "speaker": "小夏",
      "file": "voice-09.wav",
      "transcriptionVerified": false,
      "naturalListeningApproved": false
    }

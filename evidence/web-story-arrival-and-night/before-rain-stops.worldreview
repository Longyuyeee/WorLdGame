{
  "schemaVersion": 1,
  "kind": "world-playtest-notes",
  "projectId": "project_a983033c0f7180355c93",
  "notes": [
    {
      "id": "18d60a21-2273-4a0f-90b0-f87e34848830",
      "sceneId": "scene_fff36353633c42d1",
      "statementId": "stmt_ui_45",
      "sceneTitle": "候车室的旧信",
      "excerpt": "林远从包里找到一支快没墨的笔，在纸袋上写了两个日期。一个是试合作结束的那天，另一个是小夏第一堂课后的周末。他们并排看着，发现第二个日期两个人都可以空出来。小夏把它圈起，却没有先替这一天安排结局，只问他愿不愿意真的把它留在日历里。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "见面安排应在两周试合作之后，避免第一堂课的下个周末早于远行路线的试合作收尾。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073232234,
      "updatedAt": 1792073278639,
      "checkedSourceHash": null
    },
    {
      "id": "c46e8825-76b1-4fc1-a2c5-af4a94a50414",
      "sceneId": "scene_e919f09d3b7d45f7",
      "statementId": "stmt_ui_101",
      "sceneTitle": "留下",
      "excerpt": "等待上菜时，林远把试合作的邮件打开给她看。小夏没有替他修改决定，只帮他找出一个没看清的时间：第一天需要的是线上碰面，不是必须早晨站到办公室里。他们对着这句话笑了很久，笑过以后，他给自己写下以后要把完整邮件读完的提醒。林远又给联系人发了一条消息，确认先在线上开始试合作，谈清驻地安排后再改签明早的车票。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "明确取消次晨乘车，避免前面说搭明早列车、后面却在家线上工作的行程断裂。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073233208,
      "updatedAt": 1792073278604,
      "checkedSourceHash": null
    },
    {
      "id": "0b8fdbf7-94ce-4581-8740-282392f30ccd",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_148",
      "sceneTitle": "雨后的天明",
      "excerpt": "线上碰面比他想象中普通。新同事介绍了试合作的内容，询问他能投入多少时间，也明确说可以在第一周之后重新调整。林远第一次没有为了显得可靠，把每一个问题都回答成没问题。他认真看了日历，说出自己真正能够完成的范围。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "补齐留下路线实际远程安排，不把线上碰面误解为已经搬到新城市。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073234132,
      "updatedAt": 1792073278571,
      "checkedSourceHash": null
    },
    {
      "id": "14b00b94-ad55-4897-bee0-5f8850850cee",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_154",
      "sceneTitle": "雨后的天明",
      "excerpt": "他们没有因为昨天的谈话，从此不再错过消息。林远仍有忙得忘记回复的下午，小夏也有不想讲话的时候。不同的是，过了两天再联系时，他们学着说明实际情况，不把沉默变成一道让对方独自猜答案的题。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "此段已概述数日的联系，不继续以“昨天”固定整个蒙太奇的时间。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073235041,
      "updatedAt": 1792073278537,
      "checkedSourceHash": null
    },
    {
      "id": "698a904a-7f6b-4597-b5eb-4b2ba881ffee",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_156",
      "sceneTitle": "雨后的天明",
      "excerpt": "约好的周末终于到了，天气预报仍然有雨。小夏问要不要改日期。林远说，不如先去车站看看，如果列车停运，就按第二个计划在附近吃饭。他们为这个并不完美的安排笑起来，却都知道这不是放弃去海边，而是允许计划继续活在现实里。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "显式承接共同确定的两周后见面，不让课程和试合作发生在含糊的一周内。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073236191,
      "updatedAt": 1792073278502,
      "checkedSourceHash": null
    },
    {
      "id": "e8ab111c-725b-469b-b03c-1efadf0ea7f7",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_158",
      "sceneTitle": "雨后的天明",
      "excerpt": "车站的钟这次准时了。小夏特意看了一眼，林远也看了。他们不需要再偷来三分钟才能说话，反而能在列车到来之前安静地坐着，各自读一会儿书。那张照片仍夹在原来的位置，旁边多了一张写有新日期的车票。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "白天到站仍是雨夜背景；同一地点补白天变体并核对三个白天站台入口。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792073237225,
      "updatedAt": 1792073278469,
      "checkedSourceHash": null
    },
    {
      "id": "c2bd7957-b21f-432d-a7a4-74b06c0bf673",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_232",
      "sceneTitle": "再一次见面",
      "excerpt": "他们先去吃了一顿普通的早餐。林远讲新城市的路，讲哪家店晚上还开着，讲工作里仍然需要慢慢学的部分。小夏没有把这些话听成他是否应该回来的一份说明，也没有替他打分。她问了一些具体的问题，好像只是想认识他正在生活的地方。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "早餐/下午面馆仍是夜景；补白天面馆，并在下午下雨/回房时配合雨声起止。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792073238267,
      "updatedAt": 1792073278437,
      "checkedSourceHash": null
    },
    {
      "id": "f610a299-31bc-4d5d-bef3-9f0f5b802a79",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_248",
      "sceneTitle": "再一次见面",
      "excerpt": "回到房间，他把画放到窗边，把信收在抽屉最上层。海边的计划还有机会，工作和课程也各自继续。林远没有因为远行失去原来的故事，而是学会了给它新的地址：到了就说，变化就说，想念也可以说。雨停之前没有完成的话，终于有了之后一封又一封的回信。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "晚间回房仍使用晨光画室；补同一房间夜景，不改变开场和白天画面。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792073239176,
      "updatedAt": 1792073278405,
      "checkedSourceHash": null
    },
    {
      "id": "1c2d90db-c5ce-4400-a863-fa76355377c9",
      "sceneId": "scene_e919f09d3b7d45f7",
      "statementId": "stmt_ui_113",
      "sceneTitle": "留下",
      "excerpt": "明天还要出发，可今晚的回信不用再等。",
      "sourceHash": "7ebe11f3f66708f07d37a342aab7509f87145254f9e969d7489777111f086a36",
      "text": "退掉次晨车票后，语音仍说“明天还要出发”。同步修订对白与实际音频；确认不再强定次晨行程。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792079969208,
      "updatedAt": 1792079977868,
      "checkedSourceHash": null
    },
    {
      "id": "63be6397-a2d5-4a75-9cfc-881b2ea9ce39",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_167",
      "sceneTitle": "雨后的天明",
      "excerpt": "到了就告诉我实际的样子，不用只讲顺利的事。",
      "sourceHash": "7ebe11f3f66708f07d37a342aab7509f87145254f9e969d7489777111f086a36",
      "text": "结尾已总结去过新城市，才出现“到了就告诉我”。移回当日下午告别，补未来行程语境，复核蒙太奇人物退场。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792079969926,
      "updatedAt": 1792079977837,
      "checkedSourceHash": null
    },
    {
      "id": "80d2e509-61ab-4839-85aa-5c6523bb2431",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_250",
      "sceneTitle": "再一次见面",
      "excerpt": "我们有时间，把上次的故事继续讲完。",
      "sourceHash": "7ebe11f3f66708f07d37a342aab7509f87145254f9e969d7489777111f086a36",
      "text": "小夏已上车、林远独自夜归后才播放小夏的现场对白。将回应放回白天店内看画时，连同其余场景末尾配音一起对齐。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792079970607,
      "updatedAt": 1792079977802,
      "checkedSourceHash": null
    },
    {
      "id": "b717c056-bfed-4ca1-9e4b-b5aca1d0f1f5",
      "sceneId": "scene_87825610ea97b89eeea8",
      "statementId": "stmt_ui_9",
      "sceneTitle": "车站的雨",
      "excerpt": "照片上是一片没有拍到人的海。去年他们各自请了半天假，到了车站才知道列车停运，只能在便利店买两杯热饮，坐着听了一下午雨。那张照片后来由小夏寄来，背面写着：没到的地方不必作废。林远把它夹进书里，每次搬家都带着，却一次也没有认真回复。",
      "sourceHash": "1695b8fb720cbcadfe70422df2ffae170973c24cafae93aa0c946d3377d080a9",
      "text": "明确没能同行与后来寄来海边照片之间的因果，也保留小夏独立行动的生活。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792219877169,
      "updatedAt": 1792219887938,
      "checkedSourceHash": null
    },
    {
      "id": "ee4c7fb0-23a7-421e-900d-2aed4c88bd99",
      "sceneId": "scene_57cb9677c3e74e68",
      "statementId": "stmt_ui_135",
      "sceneTitle": "灯下的回信",
      "excerpt": "关门前，他们把餐桌擦干，向老板道谢。小夏拿走自己的信封，林远留下回信给她；那张旧照片仍放在书中。他们没有交换一件用来抵押未来的东西，只交换了今天认真说过的话，以及之后还愿意联系的地址。",
      "sourceHash": "1695b8fb720cbcadfe70422df2ffae170973c24cafae93aa0c946d3377d080a9",
      "text": "两封信分别由收信人保管，旧照片留在林远的书中，避免信封被拿回而信的去向不明。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792219878736,
      "updatedAt": 1792219887907,
      "checkedSourceHash": null
    },
    {
      "id": "490401e9-8a52-4764-839e-314f779dcf3b",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_164",
      "sceneTitle": "雨后的天明",
      "excerpt": "留下没有让路消失。林远仍然去过新的城市，小夏也开始了她的课程；他们仍有各自的工作和需要独自作出的决定。但每当故事走到一个需要停下来说明的地方，他们都知道可以把信拿出来，坐到灯下，把未说完的话继续写完。",
      "sourceHash": "1695b8fb720cbcadfe70422df2ffae170973c24cafae93aa0c946d3377d080a9",
      "text": "明确海边旅行之后才按协商安排远行，结束回顾前人物退场并回到日常室内，不让海边画面承担跨日总结。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792219881132,
      "updatedAt": 1792219887870,
      "checkedSourceHash": null
    },
    {
      "id": "8b506df3-d3f6-4de0-b874-3954ae965e64",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_234",
      "sceneTitle": "再一次见面",
      "excerpt": "下午开始下雨，去海边的车仍然开着，但风已经很大。他们站在站牌旁看了一会儿，决定按第二个计划找一间店坐下。林远没有再把改计划当成辜负准备的证据；小夏也没有说反正去哪里都一样。他们承认想看海，又认真选择今天更舒服的安排。",
      "sourceHash": "1695b8fb720cbcadfe70422df2ffae170973c24cafae93aa0c946d3377d080a9",
      "text": "衔接有雨的早餐背景，补齐住处到午后站台的时间和地点，使用现有站台画面而不是让人物一直留在店内。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792219882613,
      "updatedAt": 1792219887839,
      "checkedSourceHash": null
    },
    {
      "id": "736b86de-d906-4bac-a580-c83c44797bd4",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_236",
      "sceneTitle": "再一次见面",
      "excerpt": "店里的灯和那晚车站附近的灯很像。小夏把修好的书放在桌上，林远取出一张刚画完的纸。画面里有候车室的窗和两个并排的位置，没有画出他们的脸。他说，想让她看见那晚的窗后来被自己画成了什么样子。小夏把画转向光亮处，看了一会儿才开口。",
      "sourceHash": "1695b8fb720cbcadfe70422df2ffae170973c24cafae93aa0c946d3377d080a9",
      "text": "明确回到同一间店，转场和雨声转为室内后再接原有看画对白，九句配音不重写。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792219883879,
      "updatedAt": 1792219887804,
      "checkedSourceHash": null
    },
    {
      "id": "4435dfa6-7a0a-4bf8-bb49-d2396effefc3",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_238",
      "sceneTitle": "再一次见面",
      "excerpt": "小夏在画边放下一张新照片，是她课程里第一张真正完成的修复作业。照片背面写着可以继续用。林远摸着那个字，想起他们给旧海边照片留下的那行空白。故事并没有因为搬到新的城市就作废，也不必永远按原来的样子保存，才能继续被使用。",
      "sourceHash": "6decebb7dedd38df076b6d096eddd7947fd66d73e0237ee076eccaeab798382a",
      "text": "远行路线没有发生共同去海边、在照片日期旁留白的经历；回扣两条路线共享的旧照片题字，不能借用留下路线的记忆。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792222931831,
      "updatedAt": 1792222938156,
      "checkedSourceHash": null
    },
    {
      "id": "1214b934-5ec6-4b67-b500-ff6f93e2df5c",
      "sceneId": "scene_fff36353633c42d1",
      "statementId": "stmt_ui_31",
      "sceneTitle": "候车室的旧信",
      "excerpt": "候车室里只剩一排灯还亮着。小夏选了靠窗的两张椅子，隔着玻璃能看见站台上的信号灯。林远把箱子放在脚边，拆信前先问她是否介意读出声。她摇头，说如果有哪句让他不知道怎么接，也可以先停下来。信不是考试，不要求谁立刻给出正确答案。",
      "sourceHash": "6decebb7dedd38df076b6d096eddd7947fd66d73e0237ee076eccaeab798382a",
      "text": "从站台进入隔着玻璃的候车室后仍沿用室外雨声音量；进门降低到 8%，返回站台时恢复 20%，对应人物所在位置。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792222932653,
      "updatedAt": 1792222938124,
      "checkedSourceHash": null
    },
    {
      "id": "101e435e-02f2-43c0-b42b-212ea50ed89c",
      "sceneId": "scene_57cb9677c3e74e68",
      "statementId": "stmt_ui_137",
      "sceneTitle": "灯下的回信",
      "excerpt": "走出店门，雨只剩细细的一层。林远把刚才没写完的句子记进手机，又把屏幕关掉，陪小夏走到公交站。他终于能够让一件事情暂时没有完成，而不把暂时理解成永远；也能够说今晚就到这里，不必用拖延把不舍藏起来。",
      "sourceHash": "6decebb7dedd38df076b6d096eddd7947fd66d73e0237ee076eccaeab798382a",
      "text": "走出面馆送到公交站时背景仍在店内；新增独立夜雨公交站画面，保留小夏立绘，雨已减弱时改用 6% 雨声。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792222934149,
      "updatedAt": 1792222938090,
      "checkedSourceHash": null
    },
    {
      "sceneId": "scene_87825610ea97b89eeea8",
      "statementId": "stmt_ui_5",
      "sceneTitle": "车站的雨",
      "excerpt": "售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。",
      "sourceHash": "f0aeb3f0487df7ac00a706aaa7c9a44ba24abd3bf95713d67f67c7d07e089500",
      "id": "e77a1890-a1c3-458e-9f3c-c118c382dd87",
      "text": "开场林远独自等候，小夏在下一段才从街对面走来；立绘却已在第一段出现。将原 stmt_ui_4 出场指令移到 stmt_ui_7 前，保留指令 ID 和后续表情／配音。",
      "category": "stage",
      "status": "fixed",
      "checkedSourceHash": null,
      "createdAt": 1792228388624,
      "updatedAt": 1792228397631
    },
    {
      "sceneId": "scene_6948f058bf7b4347",
      "statementId": "stmt_ui_219",
      "sceneTitle": "车窗与海",
      "excerpt": "见面前夜，他把房间整理到能够招待客人的程度，没有把未完成的画藏起来。桌边留出一个可以放书的位置，窗户也擦了。他知道小夏会看见他的新生活并没有处处整齐，但这正是他想邀请她来的地方，不是一张经过删改的展示照片。",
      "sourceHash": "f0aeb3f0487df7ac00a706aaa7c9a44ba24abd3bf95713d67f67c7d07e089500",
      "id": "fdcf3fc4-52b2-4e15-b4fd-5dea75c8df85",
      "text": "“见面前夜”仍继承白天工作室背景。该段前使用已有夜间工作室，下一段仍按原指令切回次日早晨车站；不新增素材。",
      "category": "stage",
      "status": "fixed",
      "checkedSourceHash": null,
      "createdAt": 1792228390277,
      "updatedAt": 1792228397599
    },
    {
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_238",
      "sceneTitle": "再一次见面",
      "excerpt": "小夏在画边放下一张新照片，是她课程里第一张真正完成的修复作业。照片背面写着可以继续用。林远摸着那个字，想起旧海边照片背面那句“没到的地方不必作废”。从那时拖着没有寄出的回信，到现在能坐在同一张桌前继续说话，他终于明白：故事不必按原来的样子保存，才能继续被使用。",
      "sourceHash": "f0aeb3f0487df7ac00a706aaa7c9a44ba24abd3bf95713d67f67c7d07e089500",
      "id": "3eb1419c-c601-44c9-a014-f620460df416",
      "text": "小夏学习的是旧书修复，前文已带来修好的书；结尾“照片是修复作业”容易被误读为照片修复课程。明确照片记录修好的第一本书，保留旧照片题字与分支记忆。",
      "category": "text",
      "status": "fixed",
      "checkedSourceHash": null,
      "createdAt": 1792228392541,
      "updatedAt": 1792228397564
    },
    {
      "sceneId": "scene_f3c19020bde744aa",
      "statementId": "stmt_ui_83",
      "sceneTitle": "站台前的约定",
      "excerpt": "最后一班车到了，你准备怎样继续这个约定？",
      "sourceHash": "f0aeb3f0487df7ac00a706aaa7c9a44ba24abd3bf95713d67f67c7d07e089500",
      "id": "836bd5e0-fc7b-4a80-beb3-957cdfb7b19f",
      "text": "“等雨停／追最后一班车”未清楚表达两条路线都继续回信与约定；列车此时已停靠。改为“今晚留下，把回信写完／今晚出发，在路上继续”，保留选项 ID、顺序和路线目标，不给其中一条增加正确答案暗示。",
      "category": "text",
      "status": "fixed",
      "checkedSourceHash": null,
      "createdAt": 1792228394497,
      "updatedAt": 1792228397530
    }
  ]
}
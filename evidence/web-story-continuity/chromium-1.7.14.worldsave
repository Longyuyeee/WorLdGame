beforeCheckpointId\":\"history.962e457c4e4f7a7d832b3a94781653aa526898c8562456d40638a47b84c130a0\",\"effects\":[],\"entryId\":\"entry.134c6abe12e5c991ca2e2e1fb92dd289c078a301f7935900ccd43058f692878b\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.365aca837c41d2199f0fb1d4\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"99553cc8184c0e78ee0e5537f74eca72551d3ad9832b3b381e6041601f8866d9\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"62f04721f85ba03b874b7ac640fca604fc743986a8704cb3a6afc8cb4387aae7"}
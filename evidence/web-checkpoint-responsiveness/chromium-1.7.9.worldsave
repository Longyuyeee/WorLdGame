beforeCheckpointId\":\"history.a8369f132f7ffdbb18487380989dc796bdc4bffb8fbb1d731929460bd31aeaf0\",\"effects\":[],\"entryId\":\"entry.257b8467b04eeff1fb8c7639d1318f1c65b0ae36f60238be39c2309aa41cf81d\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.ee145ab84e8379e31f4d2ce6\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"6c69a29f56267ecf3da4bace7fb4e142866f47b697432cb13a333bfc7e969b8e\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"dbd99badf9f67c2138220f5a4c3f575b7aae4b1f6eb83793ed3d9062e86cf8e6"}
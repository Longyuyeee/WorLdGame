mt_ui_2\",\"effectId\":\"effect.012742cc0b944f4e472544607ff2c05117f680e61b5405310a1c0926668aad57\",\"executionId\":\"player.8315065f449ed3d7efc95e72\",\"kind\":\"audio.play\",\"logicalSequence\":1,\"originatingRevision\":2,\"payload\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_2\"}],\"entryId\":\"entry.bf9bd68cb267124c52b116e4144e572dc2a680c5ac91593857e808556796fddb\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_2\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300}},\"executedInstructions\":1,\"historyIndex\":1,\"input\":null},{\"afterCheckpointId\":\"history.5aa93baf7370dbfc418b6ec1ae7993abf538d8c6c01438e7cb47f2a1219d9dde\",\"barriers\":[],\"beforeCheckpointId\":\"history.07643f15b24c4e1def033c09a30764a98811efba425404e71834842335b67f9c\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.ambient\",\"compensation\":null,\"descriptorId\":\"stmt_ui_3\",\"effectId\":\"effect.e200fb3f45c39f5711e8e4812fc402a1535bddf829424de61465249096065370\",\"executionId\":\"player.8315065f449ed3d7efc95e72\",\"kind\":\"audio.play\",\"logicalSequence\":2,\"originatingRevision\":3,\"payload\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_3\"}],\"entryId\":\"entry.62d5d30747cb0376821a78801d4a997707f2c97efabb91289ba59d75de551b3a\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_3\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200}},\"executedInstructions\":1,\"historyIndex\":2,\"input\":null},{\"afterCheckpointId\":\"history.f00b3f6d61a2b26fd57fa6eff65ed0005db1e6010c03265efa63c6e9d0fd92fc\",\"barriers\":[],\"beforeCheckpointId\":\"history.5aa93baf7370dbfc418b6ec1ae7993abf538d8c6c01438e7cb47f2a1219d9dde\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_4\",\"effectId\":\"effect.7d966028ace5ce8ac6564738efede1fc508840dc58b9236dabd184343c7fc773\",\"executionId\":\"player.8315065f449ed3d7efc95e72\",\"kind\":\"show.show\",\"logicalSequence\":3,\"originatingRevision\":4,\"payload\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_4\"}],\"entryId\":\"entry.a6b57732b14e472b3ce6d3644e5e62d221d40e19bb9550114672eb67d3b231c9\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_4\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":3,\"input\":null},{\"afterCheckpointId\":\"history.23b366e6ddd606b581a3db9389e88416f63448d0115f6144ef74f1f9efbef3d3\",\"barriers\":[],\"beforeCheckpointId\":\"history.f00b3f6d61a2b26fd57fa6eff65ed0005db1e6010c03265efa63c6e9d0fd92fc\",\"effects\":[],\"entryId\":\"entry.e6b531d18b7e4b8ac69f79b80662c8850d40c84789483a25dbe235f1490bd7a6\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null},{\"afterCheckpointId\":\"history.57e8ad747862a84d0492b6e2adb60e86210b2df9ec3ead95b82e669eb94c28de\",\"barriers\":[],\"beforeCheckpointId\":\"history.23b366e6ddd606b581a3db9389e88416f63448d0115f6144ef74f1f9efbef3d3\",\"effects\":[],\"entryId\":\"entry.553dcb739623568ecd00ecc7d53e2d15600f4d80d8e5b85a92c11545d0374122\",\"event\":{\"instructionId\":\"stmt_ui_7\",\"kind\":\"narration\",\"text\":\"小夏不是来阻止他出发的。她在短信里只说，要把借了半年那本书还给他，顺便把书里的照片也还给他。林远原以为这是一件很容易的事：收下书，认真道谢，等广播响起后挥手。可当她撑着伞从街对面走来，他忽然不记得自己排练过的第一句话是什么了。\",\"textId\":\"txt_ui_8\"},\"executedInstructions\":1,\"historyIndex\":5,\"input\":null},{\"afterCheckpointId\":\"history.4ad1e6ff0c279e546e8fc00b5eda3e7bf15983ececd95bd7017650c39414f0df\",\"barriers\":[],\"beforeCheckpointId\":\"history.57e8ad747862a84d0492b6e2adb60e86210b2df9ec3ead95b82e669eb94c28de\",\"effects\":[],\"entryId\":\"entry.9840aee4fb808fd9c467b24c11ee67edf16eea31acd6773de70dcc3bfa6fa70c\",\"event\":{\"instructionId\":\"stmt_ui_9\",\"kind\":\"narration\",\"text\":\"照片上是一片没有拍到人的海。去年他们各自请了半天假，到了车站才知道列车停运，只能在便利店买两杯热饮，坐着听了一下午雨。那张照片后来由小夏寄来，背面写着：没到的地方不必作废。林远把它夹进书里，每次搬家都带着，却一次也没有认真回复。\",\"textId\":\"txt_ui_10\"},\"executedInstructions\":1,\"historyIndex\":6,\"input\":null}],\"executionId\":\"player.8315065f449ed3d7efc95e72\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"47269f98c50e1dca5fa4a70e7777bf914f6da17f5fba2678e4b69b86af28e3e1\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"slot"},"sha256":"1292d4b7031b722be2779d3039629a51732ebc6070eb7e76fce0ae96a284c61d"}
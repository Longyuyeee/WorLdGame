foreCheckpointId\":\"history.f00b3f6d61a2b26fd57fa6eff65ed0005db1e6010c03265efa63c6e9d0fd92fc\",\"effects\":[],\"entryId\":\"entry.e6b531d18b7e4b8ac69f79b80662c8850d40c84789483a25dbe235f1490bd7a6\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.8315065f449ed3d7efc95e72\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"e81635443103a7b1e7045090f850b26cc8b10b8c613603b61367aa732e0be878\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"slot"},"sha256":"c4978cfc255433c1f3bcf7c814d31ad1d44efccc5a887731e1a1970bb5c3ac66"}
530f3c0a1c0354\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"background\",\"compensation\":null,\"descriptorId\":\"stmt_ui_1\",\"effectId\":\"effect.1817e1cc95ecd4b2f8213524d3180f4ed06ee5f438b7b4ac9ad1c1e1178e4b66\",\"executionId\":\"player.e02160ec9e5f4b140bfebcb3\",\"kind\":\"background.set\",\"logicalSequence\":0,\"originatingRevision\":1,\"payload\":{\"action\":\"set\",\"asset\":\"sample_station\"},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_1\"}],\"entryId\":\"entry.733278ed577851c90adaa2348cc029417ce147ca23457e1e6be85275ded2a569\",\"event\":{\"command\":\"background\",\"instructionId\":\"stmt_ui_1\",\"kind\":\"direction\",\"parameters\":{\"action\":\"set\",\"asset\":\"sample_station\"}},\"executedInstructions\":1,\"historyIndex\":0,\"input\":null},{\"afterCheckpointId\":\"history.df1d929688eaec0001e69350bd1172cc5d7ea224f72ff59fb9613c2b4c5bc108\",\"barriers\":[],\"beforeCheckpointId\":\"history.1b196415ca8b27092799bb0873213c90f4543987995671ae7fda208f8a005def\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.bgm\",\"compensation\":null,\"descriptorId\":\"stmt_ui_2\",\"effectId\":\"effect.748f9d77c08863439a2154533c66a269253bd3ee75785b08665fea1b229cea9b\",\"executionId\":\"player.e02160ec9e5f4b140bfebcb3\",\"kind\":\"audio.play\",\"logicalSequence\":1,\"originatingRevision\":2,\"payload\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_2\"}],\"entryId\":\"entry.43388d530b6e709c5ec425999375e32021f12e71b34ae65f7f12fd7910c377b7\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_2\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"night_travel_theme\",\"bus\":\"bgm\",\"loop\":true,\"volumePermille\":300}},\"executedInstructions\":1,\"historyIndex\":1,\"input\":null},{\"afterCheckpointId\":\"history.f5af640bffa442d9a15e3ee43144e26edefe6bd1de2c850756f8179e7567400e\",\"barriers\":[],\"beforeCheckpointId\":\"history.df1d929688eaec0001e69350bd1172cc5d7ea224f72ff59fb9613c2b4c5bc108\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.ambient\",\"compensation\":null,\"descriptorId\":\"stmt_ui_3\",\"effectId\":\"effect.8f443a0ee561691430518b74fda96af119555b807475a199b740754db0a54360\",\"executionId\":\"player.e02160ec9e5f4b140bfebcb3\",\"kind\":\"audio.play\",\"logicalSequence\":2,\"originatingRevision\":3,\"payload\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_3\"}],\"entryId\":\"entry.5344c7ff61ec976366c616ac551da598ed65e6115439fdc70ac77151c44c6d05\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_3\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"soft_rain\",\"bus\":\"ambient\",\"loop\":true,\"volumePermille\":200}},\"executedInstructions\":1,\"historyIndex\":2,\"input\":null},{\"afterCheckpointId\":\"history.789868e76600d9a63c12034797655e9af454d7742a5c200cabece029cb9a74cd\",\"barriers\":[],\"beforeCheckpointId\":\"history.f5af640bffa442d9a15e3ee43144e26edefe6bd1de2c850756f8179e7567400e\",\"effects\":[],\"entryId\":\"entry.f0c084bc463510885b6ead9c963d5261b7aa6881eb29334e600ff11786daeb7d\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":3,\"input\":null},{\"afterCheckpointId\":\"history.e6aeaca34dd4e6ba70feb1aa8a5deeeb65d924ffad8bbc56671ef0a3430e6561\",\"barriers\":[],\"beforeCheckpointId\":\"history.789868e76600d9a63c12034797655e9af454d7742a5c200cabece029cb9a74cd\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_4\",\"effectId\":\"effect.e50b03030ef28ee20f520b5b0263cb6abf84f6de99d156c2912d0c3773eff1fd\",\"executionId\":\"player.e02160ec9e5f4b140bfebcb3\",\"kind\":\"show.show\",\"logicalSequence\":3,\"originatingRevision\":5,\"payload\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_4\"}],\"entryId\":\"entry.5f5716ac9b5b99f59d1428acddce7996c826ec201e89adcb18885445328cc2e2\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_4\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null},{\"afterCheckpointId\":\"history.da3f414e1f215b9d41886af02cf1f47d419405f46b21cfc0a0dbee074950cd3e\",\"barriers\":[],\"beforeCheckpointId\":\"history.e6aeaca34dd4e6ba70feb1aa8a5deeeb65d924ffad8bbc56671ef0a3430e6561\",\"effects\":[],\"entryId\":\"entry.79abf45c425f8ff783f72b34fa56558f5166e7aa2ec89f3ab6d4e6b0dca64091\",\"event\":{\"instructionId\":\"stmt_ui_7\",\"kind\":\"narration\",\"text\":\"小夏不是来阻止他出发的。她在短信里只说，要把借了半年那本书还给他，顺便把书里的照片也还给他。林远原以为这是一件很容易的事：收下书，认真道谢，等广播响起后挥手。可当她撑着伞从街对面走来，他忽然不记得自己排练过的第一句话是什么了。\",\"textId\":\"txt_ui_8\"},\"executedInstructions\":1,\"historyIndex\":5,\"input\":null},{\"afterCheckpointId\":\"history.395ec5588154bbc7d98197cfd5b19c6fd782e4844e438507e6c85992ea7c92c0\",\"barriers\":[],\"beforeCheckpointId\":\"history.da3f414e1f215b9d41886af02cf1f47d419405f46b21cfc0a0dbee074950cd3e\",\"effects\":[],\"entryId\":\"entry.5695e95775c8742a88026d17aa653d05e27b73876f0b7b892af076ccb50335df\",\"event\":{\"instructionId\":\"stmt_ui_9\",\"kind\":\"narration\",\"text\":\"照片上是一片没有拍到人的海。去年他们各自请了半天假，到了车站才知道列车停运，只能在便利店买两杯热饮，坐着听了一下午雨。后来小夏独自去了那片海，把拍下的照片寄给他，背面写着：没到的地方不必作废。林远把它夹进书里，每次搬家都带着，却一次也没有认真回复。\",\"textId\":\"txt_ui_10\"},\"executedInstructions\":1,\"historyIndex\":6,\"input\":null},{\"afterCheckpointId\":\"history.d4a09badad7de38cc0fb63f4429f30c7c88a992a55c61a521dfabfe90a8df536\",\"barriers\":[],\"beforeCheckpointId\":\"history.395ec5588154bbc7d98197cfd5b19c6fd782e4844e438507e6c85992ea7c92c0\",\"effects\":[],\"entryId\":\"entry.1bf9092008e2e2c091c3d71150938ac3366ef7905de8fe2a6c17f207ae2b9d93\",\"event\":{\"instructionId\":\"stmt_ui_11\",\"kind\":\"narration\",\"text\":\"他想过许多合理的理由。项目赶进度，新工作的面试，还有一张要交房租的账单。生活确实忙，也确实不容易，可那些理由越整齐，他越清楚自己遗漏了什么：他在所有能回答的事情上回答得很快，只有在小夏问他想不想再约一次的时候，总是说等忙完这一阵。\",\"textId\":\"txt_ui_12\"},\"executedInstructions\":1,\"historyIndex\":7,\"input\":null},{\"afterCheckpointId\":\"history.df6f0a5160e44cd2d2c44a49af51a1f12836c75fc4a189e95fb8e2d80f497341\",\"barriers\":[],\"beforeCheckpointId\":\"history.d4a09badad7de38cc0fb63f4429f30c7c88a992a55c61a521dfabfe90a8df536\",\"effects\":[],\"entryId\":\"entry.227f02441903b0e21f1301f0302d776f29b73e171a2d9b64c76e23a13490f1b3\",\"event\":{\"instructionId\":\"stmt_ui_13\",\"kind\":\"narration\",\"text\":\"站台的雨味让他想起那间租了三年的房间。窗边原本留着摆画架的位置，后来堆满了纸箱。他给这次换工作起名叫重新开始，仿佛只要把地址换掉，箱子里那些没画完的东西就会自己展开。小夏知道那些画，却从没催他交一张能被称作作品的结果。\",\"textId\":\"txt_ui_14\"},\"executedInstructions\":1,\"historyIndex\":8,\"input\":null},{\"afterCheckpointId\":\"history.a996dc2f9ee8f89232ed34d9487b932dfe3e1495ca9daa855f4fd0ae86335d97\",\"barriers\":[],\"beforeCheckpointId\":\"history.df6f0a5160e44cd2d2c44a49af51a1f12836c75fc4a189e95fb8e2d80f497341\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"show.primary\",\"compensation\":null,\"descriptorId\":\"stmt_ui_6\",\"effectId\":\"effect.3da09a3d661c235116e294d2c1263b27c7d2d30b781b2b60857b81c7a7bc7930\",\"executionId\":\"player.e02160ec9e5f4b140bfebcb3\",\"kind\":\"show.show\",\"logicalSequence\":4,\"originatingRevision\":10,\"payload\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":0},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_6\"}],\"entryId\":\"entry.1a8903979a54b4c797c34fb06c6e5c0f5f813dde68d04878b275ebc497a27110\",\"event\":{\"command\":\"show\",\"instructionId\":\"stmt_ui_6\",\"kind\":\"direction\",\"parameters\":{\"action\":\"show\",\"asset\":\"xia_thoughtful\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":9,\"input\":null},{\"afterCheckpointId\":\"history.4d2425a339b5135ad1ac386b25398bbb4e5ad7011658204d42ecbf27d14979c0\",\"barriers\":[],\"beforeCheckpointId\":\"history.a996dc2f9ee8f89232ed34d9487b932dfe3e1495ca9daa855f4fd0ae86335d97\",\"effects\":[],\"entryId\":\"entry.5a3408058e81b952513474747a0e359ba62bdb4593c7054f15a2e7b6b645b635\",\"event\":{\"instructionId\":\"stmt_ui_15\",\"kind\":\"narration\",\"text\":\"“我带了另一件东西。”小夏从包里取出一个没有封口的信封，“本来约好明年再拆，可现在先给你也可以。”她没有把信塞到他手里，只放在他们中间的长椅上。信封被雨气浸得有一点软，林远盯着那个角，突然觉得自己不能再用赶车来结束今天的谈话。\",\"textId\":\"txt_ui_16\"},\"executedInstructions\":1,\"historyIndex\":10,\"input\":null},{\"afterCheckpointId\":\"history.0c9a81c4d52ccb8309322b8483d3f6b5e966b5e122a6da2500a5dd7a154fc735\",\"barriers\":[],\"beforeCheckpointId\":\"history.4d2425a339b5135ad1ac386b25398bbb4e5ad7011658204d42ecbf27d14979c0\",\"effects\":[],\"entryId\":\"entry.4f4546079863f87c60a23e4b5639a8adfc920e2053c17b5ae7c1ea4f2d56a04d\",\"event\":{\"instructionId\":\"stmt_ui_17\",\"kind\":\"narration\",\"text\":\"列车晚点的通知替他们争来二十分钟。周围几个人抱怨了一声，又低头看手机；小夏却把伞靠在椅边，像是刚刚得到一张新的座位票。她问候车室是不是还开着。林远看向那扇亮着暖灯的门，点了点头，第一次主动把行李箱拉离检票线。\",\"textId\":\"txt_ui_18\"},\"executedInstructions\":1,\"historyIndex\":11,\"input\":null},{\"afterCheckpointId\":\"history.86b12a419b3433daf0f77734d3ba70dafcfd2c06211adee64c6d7c1eb156361a\",\"barriers\":[],\"beforeCheckpointId\":\"history.0c9a81c4d52ccb8309322b8483d3f6b5e966b5e122a6da2500a5dd7a154fc735\",\"effects\":[],\"entryId\":\"entry.4d69e4fa3bdfcb94350f891928899a91f7c8b29c9bdf9f14a9894b06155a9cb9\",\"event\":{\"instructionId\":\"stmt_ui_19\",\"kind\":\"narration\",\"text\":\"他们把湿外套抖了抖，没有立即谈信，也没有先给彼此一个结论。林远替她搬开椅上的报纸，小夏给他的书套上一个干燥的纸袋。原来愿意多停一会儿可以是这样小的一件事：承认话还没说完，并且真的坐下来，为它腾出时间。\",\"textId\":\"txt_ui_20\"},\"executedInstructions\":1,\"historyIndex\":12,\"input\":null},{\"afterCheckpointId\":\"history.2ab258a5275dee9598924ced56f41db9187ebd117861c5dc31ea4ad00f6cad71\",\"barriers\":[],\"beforeCheckpointId\":\"history.86b12a419b3433daf0f77734d3ba70dafcfd2c06211adee64c6d7c1eb156361a\",\"effects\":[],\"entryId\":\"entry.fd81a4cd44c99266d33cf6f89630b8d8e9da6bc06d6736d524c66d92b792ed11\",\"event\":{\"instructionId\":\"stmt_ui_21\",\"kind\":\"narration\",\"text\":\"走向候车室之前，林远给新公司的联系人写了一条消息，说列车晚点，预计到达时间会有变化。发送成功后，他收起手机，从长椅上捡起那封信。纸角已经有些湿了，他用掌心护着，抬头等小夏。\",\"textId\":\"txt_ui_22\"},\"executedInstructions\":1,\"historyIndex\":13,\"input\":null},{\"afterCheckpointId\":\"history.be1e1c5876100929b088ca1eb34beecaebea10d02b404a6f0acc88d4243838de\",\"barriers\":[],\"beforeCheckpointId\":\"history.2ab258a5275dee9598924ced56f41db9187ebd117861c5dc31ea4ad00f6cad71\",\"effects\":[{\"awaitMode\":\"detached\",\"cancellationScope\":\"scope.scene_87825610ea97b89eeea8\",\"channel\":\"audio.voice\",\"compensation\":null,\"descriptorId\":\"stmt_ui_8\",\"effectId\":\"effect.5833ce8d007d27c220b3039974cbe4d076de407626c947eb34ba2f79ec18d9f0\",\"executionId\":\"player.e02160ec9e5f4b140bfebcb3\",\"kind\":\"audio.play\",\"logicalSequence\":5,\"originatingRevision\":15,\"payload\":{\"action\":\"play\",\"asset\":\"voice_01\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000},\"policy\":\"pure\",\"replayKey\":\"replay.stmt_ui_8\"}],\"entryId\":\"entry.63e92d114cd046293c8ded2310391d5079807359992cf7d632655080b642f584\",\"event\":{\"command\":\"audio\",\"instructionId\":\"stmt_ui_8\",\"kind\":\"direction\",\"parameters\":{\"action\":\"play\",\"asset\":\"voice_01\",\"bus\":\"voice\",\"loop\":false,\"volumePermille\":1000}},\"executedInstructions\":1,\"historyIndex\":14,\"input\":null},{\"afterCheckpointId\":\"history.06a2114ecdb8dd78c27df1894a8714e79c27790bb772a52cea099ffe5233e815\",\"barriers\":[],\"beforeCheckpointId\":\"history.be1e1c5876100929b088ca1eb34beecaebea10d02b404a6f0acc88d4243838de\",\"effects\":[],\"entryId\":\"entry.c919f950fb58c8f567a022e6af652cb01817fd5823b7ae75cb27fcf7907e8a09\",\"event\":{\"instructionId\":\"stmt_ui_25\",\"kind\":\"dialogue\",\"speakerId\":\"character_e3a0cb3de37d44b4\",\"text\":\"进去读吧。我想先把今天的话说完。\",\"textId\":\"txt_ui_26\"},\"executedInstructions\":1,\"historyIndex\":15,\"input\":null}],\"executionId\":\"player.e02160ec9e5f4b140bfebcb3\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"4c6817d5750b8b01120cac13be3782896d85a096c05d50a0e9a89ba92d96918b\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":"","origin":"current"},"sha256":"aafee95088d7409900b42e743556ee48478806549fadc660bb6fbd88e5a1efa6"}
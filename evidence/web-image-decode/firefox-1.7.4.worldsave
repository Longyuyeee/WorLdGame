beforeCheckpointId\":\"history.2c4ea6120dcc8021f71b1c23e45f17d4054f813048a9063910d3c73588f00b81\",\"effects\":[],\"entryId\":\"entry.25b8ff1b6524d297758660f1b241402a9b57ad9ec28b07188d420bda1eba946d\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.e7aeb9e7aef91ce21566c7bf\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"6ca7ae0e848495fcbf97b5b83a92ae800192c32b5ff7c1a127cdb77fc11b30c3\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"28a819de1ac8601695f1fcbcb4e31e97d93df3c686df7bbd04d5a75b366e2118"}
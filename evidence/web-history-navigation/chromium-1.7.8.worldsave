beforeCheckpointId\":\"history.69147075a7c0eaf2f5a7c62754395661b174cad4f79bc5f83db4c51606807ea0\",\"effects\":[],\"entryId\":\"entry.e31b9527056cce2cbd6817c76d92ca01cbaac74198d8183e2b503685ff3fe9df\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.1909d74335bdb7db6e761891\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"2ef0f257ad62214af1af3130caf30634607b5c9ec2579487c4302cf5a6f59c37\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"ee31c55dcc6f32eb9e5592055f6f6c66621808ca18a818ac0144807bb21037e9"}
beforeCheckpointId\":\"history.ee0af345d3364b4f89d80c70df469f344ff435fccf1df7ca89384287e7c7920c\",\"effects\":[],\"entryId\":\"entry.a15ce1e8cd421caee8e6aedf73774103b8d6418e4d248c28586ac30bc90e2a7c\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.b16cfa0d78ffaa70fdc08314\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"24c737f8d24159e752a211415faf3fd2dad0a2e8609fe41edeaacf1c60eb81f5\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"1bd57fedbd55e83291a05991094a525c1a8a7ee5fb6945d88e5c35e7cbc78b8f"}
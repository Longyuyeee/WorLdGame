beforeCheckpointId\":\"history.40905908cdd790cbc2c29f4a0edc5dc7661ae727d3d36676a80137d4d79fe5af\",\"effects\":[],\"entryId\":\"entry.ac435a1e9017b24948d1c2f2c507680d624ef48a6da12ebbcc39e6e6c76215eb\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.dcb2b61266dd9e6ffc7ddca0\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"d70f45d851886be87d3dd50b9536eb4d1d425274bb272298cc3c1cd52110069a\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"cfc37498b84023c4886b1b4b74dd756210e51a7a6c552dd932e815499f5e4cf6"}
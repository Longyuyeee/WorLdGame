beforeCheckpointId\":\"history.aeba6a2bfc82292a184de73a56bfb2b6e1b80b913fe77d112b4a4d75f52a0662\",\"effects\":[],\"entryId\":\"entry.4cf337a718938dad3f3582664e263780a8f43ba33a8e99694c15208760e1736b\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.47861c0db5b4d21b998e7132\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"520b67f5de6d7aedbb59324a8f6cadf8eef94dc73d38fb7c1bdeb2fd3521f719\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"7c35fb225e4ea75f869783bc65916d3d2fbdd82a3c8bf871c570aad7881af892"}
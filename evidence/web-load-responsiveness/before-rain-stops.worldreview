{
  "schemaVersion": 1,
  "kind": "world-playtest-notes",
  "projectId": "project_a983033c0f7180355c93",
  "notes": [
    {
      "id": "18d60a21-2273-4a0f-90b0-f87e34848830",
      "sceneId": "scene_fff36353633c42d1",
      "statementId": "stmt_ui_45",
      "sceneTitle": "候车室的旧信",
      "excerpt": "林远从包里找到一支快没墨的笔，在纸袋上写了两个日期。一个是试合作结束的那天，另一个是小夏第一堂课后的周末。他们并排看着，发现第二个日期两个人都可以空出来。小夏把它圈起，却没有先替这一天安排结局，只问他愿不愿意真的把它留在日历里。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "见面安排应在两周试合作之后，避免第一堂课的下个周末早于远行路线的试合作收尾。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073232234,
      "updatedAt": 1792073278639,
      "checkedSourceHash": null
    },
    {
      "id": "c46e8825-76b1-4fc1-a2c5-af4a94a50414",
      "sceneId": "scene_e919f09d3b7d45f7",
      "statementId": "stmt_ui_101",
      "sceneTitle": "留下",
      "excerpt": "等待上菜时，林远把试合作的邮件打开给她看。小夏没有替他修改决定，只帮他找出一个没看清的时间：第一天需要的是线上碰面，不是必须早晨站到办公室里。他们对着这句话笑了很久，笑过以后，他给自己写下以后要把完整邮件读完的提醒。林远又给联系人发了一条消息，确认先在线上开始试合作，谈清驻地安排后再改签明早的车票。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "明确取消次晨乘车，避免前面说搭明早列车、后面却在家线上工作的行程断裂。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073233208,
      "updatedAt": 1792073278604,
      "checkedSourceHash": null
    },
    {
      "id": "0b8fdbf7-94ce-4581-8740-282392f30ccd",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_148",
      "sceneTitle": "雨后的天明",
      "excerpt": "线上碰面比他想象中普通。新同事介绍了试合作的内容，询问他能投入多少时间，也明确说可以在第一周之后重新调整。林远第一次没有为了显得可靠，把每一个问题都回答成没问题。他认真看了日历，说出自己真正能够完成的范围。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "补齐留下路线实际远程安排，不把线上碰面误解为已经搬到新城市。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073234132,
      "updatedAt": 1792073278571,
      "checkedSourceHash": null
    },
    {
      "id": "14b00b94-ad55-4897-bee0-5f8850850cee",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_154",
      "sceneTitle": "雨后的天明",
      "excerpt": "他们没有因为昨天的谈话，从此不再错过消息。林远仍有忙得忘记回复的下午，小夏也有不想讲话的时候。不同的是，过了两天再联系时，他们学着说明实际情况，不把沉默变成一道让对方独自猜答案的题。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "此段已概述数日的联系，不继续以“昨天”固定整个蒙太奇的时间。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073235041,
      "updatedAt": 1792073278537,
      "checkedSourceHash": null
    },
    {
      "id": "698a904a-7f6b-4597-b5eb-4b2ba881ffee",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_156",
      "sceneTitle": "雨后的天明",
      "excerpt": "约好的周末终于到了，天气预报仍然有雨。小夏问要不要改日期。林远说，不如先去车站看看，如果列车停运，就按第二个计划在附近吃饭。他们为这个并不完美的安排笑起来，却都知道这不是放弃去海边，而是允许计划继续活在现实里。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "显式承接共同确定的两周后见面，不让课程和试合作发生在含糊的一周内。",
      "category": "text",
      "status": "fixed",
      "createdAt": 1792073236191,
      "updatedAt": 1792073278502,
      "checkedSourceHash": null
    },
    {
      "id": "e8ab111c-725b-469b-b03c-1efadf0ea7f7",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_158",
      "sceneTitle": "雨后的天明",
      "excerpt": "车站的钟这次准时了。小夏特意看了一眼，林远也看了。他们不需要再偷来三分钟才能说话，反而能在列车到来之前安静地坐着，各自读一会儿书。那张照片仍夹在原来的位置，旁边多了一张写有新日期的车票。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "白天到站仍是雨夜背景；同一地点补白天变体并核对三个白天站台入口。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792073237225,
      "updatedAt": 1792073278469,
      "checkedSourceHash": null
    },
    {
      "id": "c2bd7957-b21f-432d-a7a4-74b06c0bf673",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_232",
      "sceneTitle": "再一次见面",
      "excerpt": "他们先去吃了一顿普通的早餐。林远讲新城市的路，讲哪家店晚上还开着，讲工作里仍然需要慢慢学的部分。小夏没有把这些话听成他是否应该回来的一份说明，也没有替他打分。她问了一些具体的问题，好像只是想认识他正在生活的地方。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "早餐/下午面馆仍是夜景；补白天面馆，并在下午下雨/回房时配合雨声起止。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792073238267,
      "updatedAt": 1792073278437,
      "checkedSourceHash": null
    },
    {
      "id": "f610a299-31bc-4d5d-bef3-9f0f5b802a79",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_248",
      "sceneTitle": "再一次见面",
      "excerpt": "回到房间，他把画放到窗边，把信收在抽屉最上层。海边的计划还有机会，工作和课程也各自继续。林远没有因为远行失去原来的故事，而是学会了给它新的地址：到了就说，变化就说，想念也可以说。雨停之前没有完成的话，终于有了之后一封又一封的回信。",
      "sourceHash": "534476dea96689a86742820f27be2ed8aa832db42f66dfabbd5b796e48aca1ef",
      "text": "晚间回房仍使用晨光画室；补同一房间夜景，不改变开场和白天画面。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792073239176,
      "updatedAt": 1792073278405,
      "checkedSourceHash": null
    },
    {
      "id": "1c2d90db-c5ce-4400-a863-fa76355377c9",
      "sceneId": "scene_e919f09d3b7d45f7",
      "statementId": "stmt_ui_113",
      "sceneTitle": "留下",
      "excerpt": "明天还要出发，可今晚的回信不用再等。",
      "sourceHash": "7ebe11f3f66708f07d37a342aab7509f87145254f9e969d7489777111f086a36",
      "text": "退掉次晨车票后，语音仍说“明天还要出发”。同步修订对白与实际音频；确认不再强定次晨行程。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792079969208,
      "updatedAt": 1792079977868,
      "checkedSourceHash": null
    },
    {
      "id": "63be6397-a2d5-4a75-9cfc-881b2ea9ce39",
      "sceneId": "scene_9f0052a9d0d84faa",
      "statementId": "stmt_ui_167",
      "sceneTitle": "雨后的天明",
      "excerpt": "到了就告诉我实际的样子，不用只讲顺利的事。",
      "sourceHash": "7ebe11f3f66708f07d37a342aab7509f87145254f9e969d7489777111f086a36",
      "text": "结尾已总结去过新城市，才出现“到了就告诉我”。移回当日下午告别，补未来行程语境，复核蒙太奇人物退场。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792079969926,
      "updatedAt": 1792079977837,
      "checkedSourceHash": null
    },
    {
      "id": "80d2e509-61ab-4839-85aa-5c6523bb2431",
      "sceneId": "scene_9a1c57d3f36349f1",
      "statementId": "stmt_ui_250",
      "sceneTitle": "再一次见面",
      "excerpt": "我们有时间，把上次的故事继续讲完。",
      "sourceHash": "7ebe11f3f66708f07d37a342aab7509f87145254f9e969d7489777111f086a36",
      "text": "小夏已上车、林远独自夜归后才播放小夏的现场对白。将回应放回白天店内看画时，连同其余场景末尾配音一起对齐。",
      "category": "stage",
      "status": "fixed",
      "createdAt": 1792079970607,
      "updatedAt": 1792079977802,
      "checkedSourceHash": null
    }
  ]
}
{"schemaVersion":1,"format":"world.player-save-backup","payload":{"slot":{"kind":"manual","slotId":"manual-1","projectId":"project_a983033c0f7180355c93","buildId":"6e0e2d27c775847be3a63b6f41598bd5b5a124cf01cfe0de4988907bf02b4d41","savedAtEpochMilliseconds":1792227605898,"title":"雨停之前","chapterId":"chapter_fb27b85ca00fd9790811","chapterTitle":"Main","sceneId":"scene_87825610ea97b89eeea8","sceneTitle":"车站的雨","route":null,"customMetadata":{},"readingExcerpt":"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。","preview":{"status":"available","mimeType":"image/webp","width":237,"height":512,"byteLength":20216,"sha256":"df2265351cabf0ce79b1244b3bc83afe857b70c5ee1b3fdd4fcf0425529a9fb7"},"presentationKind":"narration","runtimeStateHash":"6aac2d7b80ab06ff905cd43392ceebf93ce907661e5f35d16e4adb8814c82cee","sessionArtifactHash":"113af3bcb753120897a35297eb2c9fb6f80b2077c30abd32b7117b199eb00de2","serializedSessionSave":"{\"buildId\":\"6e0e2d27c775847be3a63b6f41598bd5b5a124cf01cfe0de4988907bf02b4d41\",\"cursor\":5,\"executionId\":\"player.6e0e2d27c775847be3a63b6f\",\"format\":\"world.runtime-session-save\",\"history\":{\"archives\":[],\"buildId\":\"6e0e2d27c775847be3a63b6f41598bd5b5a124cf01cfe0de4988907bf02b4d41\",\"checkpoints\":[{\"checkpointId\":\"history.d2b1572493c7594e8d8bff42749dc38d15cfcab1b611c76e4b7d54d8f19e5135\",\"state\":{\"audioState\":{\"tracks\":{}},\"barrierLedger\":[],\"buildId\":\"6e0e2d27c775847be3a63b6f41598bd5b5a124cf01cfe0de4988907bf02b4d41\",\"callStack\":[],\"cursor\":{\"instructionIndex\":0,\"sceneId\":\"scene_87825610ea97b89eeea8\"},\"executionId\":\"player.6e0e2d27c775847be3a63b6f\",\"inputReceipts\":[],\"irVersion\":\"1.2.0\",\"logicalTimeMilliseconds\":0,\"metaProgress\":{\"progressScopeId\":\"player\",\"projectId\":\"project_a983033c0f7180355c93\",\"reachedEndingIds\":[],\"readTextIds\":[],\"schemaVersion\":1,\"unlockedGalleryAssetIds\":[]},\"nextEf
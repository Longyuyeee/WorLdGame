{\"action\":\"show\",\"asset\":\"xia_letter\",\"position\":\"left\",\"slot\":\"primary\",\"z\":\"0\"}},\"executedInstructions\":1,\"historyIndex\":3,\"input\":null},{\"afterCheckpointId\":\"history.6aac2d7b80ab06ff905cd43392ceebf93ce907661e5f35d16e4adb8814c82cee\",\"barriers\":[],\"beforeCheckpointId\":\"history.0f9814ee9f12f0be0176b8b36bfd0db776663672718908b1d8292494fedcb498\",\"effects\":[],\"entryId\":\"entry.494a3af4b1c4708ea6e0faa992ad81835e5fe64fd5c3d79df9cfd7fa4f6532ba\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.6e0e2d27c775847be3a63b6f\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"ce2f9c13a33e28e762f7f65b47c87c4a9fc22e3fe6ae63321906bbea3488fb27\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":"","origin":"current"},"sha256":"605755a2792eb3842ecb97bf974490e4d137c3ba7a3c81d1099c4f56b7aea791"}
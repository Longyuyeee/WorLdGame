beforeCheckpointId\":\"history.cf0a9a40425f30af3316fa71b189adcfe44cef59a3e9da35d4ad51b648f7eda0\",\"effects\":[],\"entryId\":\"entry.804846fd23c3bd0c19f7c513fa15c8d4a0ebcf4435429d87ec7e3ea71acf192b\",\"event\":{\"instructionId\":\"stmt_ui_5\",\"kind\":\"narration\",\"text\":\"售票员把窗口里的灯关掉时，雨正沿着站台的屋檐连成一条线。站台上的钟比手机慢了三分钟。林远核对了两次，没有走去询问值班员。他看见玻璃上自己的倒影，才发现他已经穿着这件外套站了很久。行李箱旁挂着新公司的地址，手机里存着一份还没签字的合同；这些东西都能说明他要去哪里，却没有一样能替他解释为什么迟迟不肯往前走。\",\"textId\":\"txt_ui_6\"},\"executedInstructions\":1,\"historyIndex\":4,\"input\":null}],\"executionId\":\"player.70f80de0741864c84cc54b00\",\"inputTombstones\":[],\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2},\"historyHash\":\"82c02ec4e5b8f19d3eaac1b9956a6958bb6c58d885464faff1ea11b49aaecae9\",\"irVersion\":\"1.2.0\",\"projectId\":\"project_a983033c0f7180355c93\",\"runtimeVersion\":\"0.6.0\",\"schemaVersion\":2}","checkpointStepId":null,"schemaVersion":3,"format":"world.player-save-slot","migratedFromSchemaVersion":null},"previewBase64":null,"origin":"current"},"sha256":"56644be2ec9bae076de29147f0ba0872219381c326bf13ee1c528d0b5613e1c8"}